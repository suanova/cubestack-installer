# ===== CubeStackInstaller 环境变量示例 =====

# 安全(生产环境务必修改)
SECRET_KEY=cubestackinstaller-dev-secret-change-me
TOKEN_EXPIRE_MINUTES=1440

# 管理员初始密码(首次启动创建 admin 时生效;**必须修改**, 禁止使用示例外的真实口令)
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# 数据库(默认 SQLite;生产可换 PostgreSQL)
DATABASE_URL=sqlite:///./userhub.db

# 部署引擎模式:auto | real | sim
DEPLOY_MODE=auto

# KubeVirt 接入
KUBECONFIG_PATH=~/.kube/config
KUBEVIRT_NAMESPACE=default
