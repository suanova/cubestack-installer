# =====================================================================
# Dockerfile-cli-incremental — CLI 容器**代码层**(只改脚本时用; 不跑依赖对齐)
# ---------------------------------------------------------------------
# 与 Dockerfile-cli 的唯一区别: **跳过 pip 依赖对齐**(假定 requirements.txt 没变)。
# 两者现在都 `FROM <base 镜像>`(见 Dockerfile-cli-base), 因此:
#   · 都很快(不重装 apt/pip);
#   · **层数不累积** —— 每次都基于同一个 base, 而不是叠在上一版镜像上(旧做法实测 443→590 层,
#     会撞 containerd overlayfs 的 lowerdir 上限 → buildkit `invalid argument`)。
# 什么时候用哪个:
#   · 只改部署脚本/清单/文档  → 本文件(--incremental), 秒级;
#   · 同时改了 requirements.txt / 需要联网补依赖 → Dockerfile-cli(--build);
#   · 新增了系统 package / 工具               → 先重建 base(--base), 再做代码层。
# =====================================================================

ARG CLI_BASE_TAG=harbor.isuanova.com/cubestack/cubestack-installer-cli-base:latest
FROM ${CLI_BASE_TAG}

# 运行期工具链钩子(登录 shell 把挂载版本目录里的 kubectl/helm/skopeo 补到 PATH)
COPY deployments/scripts/tools/docker/cli-toolchain-from-offline.sh /etc/profile.d/50-cubestack-tools.sh
RUN chmod 0644 /etc/profile.d/50-cubestack-tools.sh

# 拷贝源码(先清空再拷入: 基础镜像含旧源码, 避免已删除的文件残留)
WORKDIR ${REPO_ROOT}
RUN rm -rf ${REPO_ROOT}/deployments ${REPO_ROOT}/skills 2>/dev/null || true
COPY deployments ${REPO_ROOT}/deployments
COPY skills ${REPO_ROOT}/skills

# 校验关键路径就位(base 已带 ansible; 本层只有代码与钩子)
RUN test -f ${REPO_ROOT}/deployments/scripts/deploy-cluster.sh \
 && test -d ${REPO_ROOT}/deployments/kubespray/kubespray \
 && test -d ${REPO_ROOT}/deployments/cubestack-addon \
 && ansible --version 2>/dev/null | head -1

WORKDIR ${REPO_ROOT}
CMD ["/bin/bash"]
