# 后端环境变量(与根目录 .env.example 一致)
SECRET_KEY=cubestackinstaller-dev-secret-change-me
TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./userhub.db
DEPLOY_MODE=auto
KUBECONFIG_PATH=~/.kube/config
KUBEVIRT_NAMESPACE=default

# MinIO 对象存储(虚拟机模板镜像源;生产/真实部署必须改成真实凭据)
MINIO_ENDPOINT=10.66.1.207:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=cubestack
MINIO_PREFIX=installer/vm
MINIO_SECURE=false

# 集群节点初始密码(ssh-copy-id 用;真实部署必须覆盖)
CLUSTER_NODE_PASSWORD=CHANGE_ME
# Ansible 安装 PyPI 源(国内可配阿里云/清华镜像)
CLUSTER_PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/
