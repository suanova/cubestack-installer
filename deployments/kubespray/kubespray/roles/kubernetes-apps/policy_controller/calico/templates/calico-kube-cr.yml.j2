---
kind: ClusterRole
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: calico-kube-controllers
  namespace: kube-system
rules:
{% if calico_datastore == "etcd"  %}
  # Pods are monitored for changing labels.
  # The node controller monitors Kubernetes nodes.
  # Namespace and serviceaccount labels are used for policy.
  - apiGroups: [""]
    resources:
      - pods
      - nodes
      - namespaces
      - serviceaccounts
    verbs:
      - watch
      - list
      - get
  # Watch for changes to Kubernetes NetworkPolicies.
  - apiGroups: ["networking.k8s.io"]
    resources:
      - networkpolicies
    verbs:
      - watch
      - list
  # Services are monitored for service LoadBalancer IP allocation
  - apiGroups: [""]
    resources:
      - services
      - services/status
    verbs:
      - get
      - list
      - update
      - watch
{% elif calico_datastore == "kdd" %}
  # Nodes are watched to monitor for deletions.
  - apiGroups: [""]
    resources:
      - nodes
    verbs:
      - watch
      - list
      - get
  # Pods are queried to check for existence.
  - apiGroups: [""]
    resources:
      - pods
    verbs:
      - watch
      - list
      - get
  # IPAM resources are manipulated when nodes are deleted.
  - apiGroups: ["crd.projectcalico.org"]
    resources:
      - ipreservations
    verbs:
      - list
  # Pools are watched to maintain a mapping of blocks to IP pools.
  - apiGroups: ["crd.projectcalico.org"]
    resources:
      - ippools
    verbs:
      - list
      - watch
  - apiGroups: ["crd.projectcalico.org"]
    resources:
      - blockaffinities
      - ipamblocks
      - ipamhandles
      - ipamconfigs
      - tiers
    verbs:
      - get
      - list
      - create
      - update
      - delete
      - watch
  # kube-controllers manages hostendpoints.
  - apiGroups: ["crd.projectcalico.org"]
    resources:
      - hostendpoints
    verbs:
      - get
      - list
      - create
      - update
      - delete
      - watch
  # Needs access to update clusterinformations.
  - apiGroups: ["crd.projectcalico.org"]
    resources:
      - clusterinformations
    verbs:
      - get
      - list
      - create
      - update
      - watch
  # KubeControllersConfiguration is where it gets its config
  - apiGroups: ["crd.projectcalico.org"]
    resources:
      - kubecontrollersconfigurations
    verbs:
      # read its own config
      - get
      - list
      # create a default if none exists
      - create
      # update status
      - update
      # watch for changes
      - watch
  # Status subresource authorization is independent of the parent resource
  # (上面的 update 不覆盖 kubecontrollersconfigurations/status)。缺此规则控制器每次回写状态
  # 恒 403(实机 2026-10-15 持续报错) —— cubestack: 见 cubestack-patches/15-calico-3.32.2-rbac.patch
  - apiGroups: ["crd.projectcalico.org"]
    resources:
      - kubecontrollersconfigurations/status
    verbs:
      - get
      - update
  # KubeVirt VM/VMI informers for IPAM garbage collection of KubeVirt workloads.
  # cubestack: 上游 calico 3.32.2 逐字对齐; 见 cubestack-patches/15-calico-3.32.2-rbac.patch
  - apiGroups: ["kubevirt.io"]
    resources:
      - virtualmachines
      - virtualmachineinstances
    verbs:
      - get
      - list
      - watch
  # kube-controllers 的 policy-name-migrator / CRD 处理需要读取的集群级资源
  # (上游 3.32.2 同位规则, 其中 apiservices/CRD 的 create/delete 上游亦有, 此处只取读权限 —— 最小够用;
  #  缺这些读权限时迁移器每 5s 重试并在日志刷 forbidden, 2026-10-15 实机逐条暴露)
  - apiGroups: ["apps"]
    resources:
      - daemonsets
      - deployments
    verbs:
      - get
      - list
      - watch
  - apiGroups: ["apiextensions.k8s.io"]
    resources:
      - customresourcedefinitions
    verbs:
      - get
      - list
      - watch
  - apiGroups: ["apiregistration.k8s.io"]
    resources:
      - apiservices
    verbs:
      - get
      - list
      - watch
  # 策略改名迁移(存量集群升级路径); 上游同牌动词为 create/delete/get/list/update/watch, 逐字保留
  - apiGroups: ["crd.projectcalico.org"]
    resources:
      - networkpolicies
      - stagednetworkpolicies
      - stagedglobalnetworkpolicies
      - globalnetworkpolicies
    verbs:
      - create
      - delete
      - get
      - list
      - update
      - watch
  # Services are monitored for service LoadBalancer IP allocation
  - apiGroups: [""]
    resources:
      - services
      - services/status
    verbs:
      - get
      - list
      - update
      - watch
  # Namespaces are watched for LoadBalancer IP allocation with namespace selector support
  - apiGroups: [""]
    resources:
      - namespaces
    verbs:
      - get
      - list
      - watch
{% endif %}
