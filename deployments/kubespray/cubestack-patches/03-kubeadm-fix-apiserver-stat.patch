# patch: 03-kubeadm-fix-apiserver-stat.patch
# 目标: roles/kubernetes/control-plane/tasks/kubeadm-fix-apiserver.yml
# 加入: 2026-09-28(随 v2.28.0 → v2.32.0 迁移)
# 原因: 改 component kubeconfig 的 server 字段前先 stat 探测文件是否存在(+stat 探测 kubeconfig 是否存在, 缺文件时不再硬失败);丢了则 kubeconfig 缺失时 lineinfile 直接报错、play 中断。
# 上游吸收判据: 上游 roles/kubernetes/control-plane/tasks/kubeadm-fix-apiserver.yml 出现 kubeconfig 存在性守卫(stat 或 when: ... is exists)。
# 上游化: 建议提 PR(通用幂等健壮性, 非本环境特有; §3.5 首批为 metallb, 本条为其后候选)。
# ------------------------------------------------------------
--- a/roles/kubernetes/control-plane/tasks/kubeadm-fix-apiserver.yml
+++ b/roles/kubernetes/control-plane/tasks/kubeadm-fix-apiserver.yml
@@ -1,4 +1,16 @@
 ---
+- name: Check if kubeconfig file exists
+  stat:
+    path: "{{ kube_config_dir }}/{{ item }}"
+    get_attributes: false
+    get_checksum: false
+    get_mime: false
+  register: kubeconfig_file_stat
+  with_items:
+    - admin.conf
+    - controller-manager.conf
+    - kubelet.conf
+    - scheduler.conf
 
 - name: Update server field in component kubeconfigs
   lineinfile:
@@ -11,7 +23,13 @@
     - controller-manager.conf
     - kubelet.conf
     - scheduler.conf
+  when: >-
+    kubeconfig_file_stat.results |
+    selectattr('item', 'equalto', item) |
+    map(attribute='stat.exists') |
+    first |
+    default(false)
   notify:
     - "Control plane | Restart kube-controller-manager"
     - "Control plane | Restart kube-scheduler"
-    - "Control plane | reload kubelet"
+    - "Control plane | reload kubelet"
\ No newline at end of file
