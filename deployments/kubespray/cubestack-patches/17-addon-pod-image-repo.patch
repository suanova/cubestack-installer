# patch: 17-addon-pod-image-repo.patch
# 目标: roles/kubernetes-apps/external_provisioner/local_path_provisioner/templates/local-path-storage-deployment.yml.j2
#       roles/kubernetes-apps/registry/templates/registry-rs.yml.j2
#       roles/kubernetes/node/templates/manifests/nginx-proxy.manifest.j2
# 加入: 2026-11-19(2.1.0 离线安装: local-path helper 120s 超时 → PVC 不 Bound → registry 起不来)
# 原因: 离线版本树的镜像 tar 以 mirror 名打包(RepoTags = <harbor>/mirrors/<上游全名>),
#       ctr import 后 containerd 里只有 mirror 名; 而这些 addon 运行在**内置 registry 就绪之前**,
#       只能命中 containerd 本地镜像 —— 继续渲染上游名(docker.io/...)在断网环境必然 ImagePullBackOff。
#       不能直接改 `*_image_repo`: download role 用同一个变量推导缓存 tar 文件名
#       (image_reponame | regex_replace('/|\0|:', '_') + '.tar'), 而版本树 tar 名是上游形态
#       (如 docker.io_library_registry_2.8.1.tar); 改了会 cache miss → 试图联网 pull → 离线失败。
#       nginx-proxy(节点侧 API 本地代理静态 Pod)同理: 它的镜像也是 docker.io/library/nginx。
#       因此引入"仅 Pod 引用"的覆盖变量: 未设置时行为与上游完全一致(default), installer 在
#       mirror 模式下写 * _pod_image_repo/_tag 指向预加载镜像; download 仍按上游名找 tar。
# 上游吸收判据: 上游提供"镜像缓存名与 Pod 引用解耦"的机制(如独立 cache_repo / 别名变量)
# 上游化: 不提 PR(CubeStack 的离线 tar 命名与 mirror 布局是本仓库约定; 上游无此需求)
# ------------------------------------------------------------
diff --git a/roles/kubernetes-apps/external_provisioner/local_path_provisioner/templates/local-path-storage-deployment.yml.j2 b/roles/kubernetes-apps/external_provisioner/local_path_provisioner/templates/local-path-storage-deployment.yml.j2
--- a/roles/kubernetes-apps/external_provisioner/local_path_provisioner/templates/local-path-storage-deployment.yml.j2
+++ b/roles/kubernetes-apps/external_provisioner/local_path_provisioner/templates/local-path-storage-deployment.yml.j2
@@ -17,7 +17,7 @@
       serviceAccountName: local-path-provisioner-service-account
       containers:
       - name: local-path-provisioner
-        image: {{ local_path_provisioner_image_repo }}:{{ local_path_provisioner_image_tag }}
+        image: {{ local_path_provisioner_pod_image_repo | default(local_path_provisioner_image_repo) }}:{{ local_path_provisioner_pod_image_tag | default(local_path_provisioner_image_tag) }}
         imagePullPolicy: {{ k8s_image_pull_policy }}
         command:
         - local-path-provisioner
diff --git a/roles/kubernetes-apps/registry/templates/registry-rs.yml.j2 b/roles/kubernetes-apps/registry/templates/registry-rs.yml.j2
--- a/roles/kubernetes-apps/registry/templates/registry-rs.yml.j2
+++ b/roles/kubernetes-apps/registry/templates/registry-rs.yml.j2
@@ -31,7 +31,7 @@
         runAsUser: 1000
       containers:
         - name: registry
-          image: {{ registry_image_repo }}:{{ registry_image_tag }}
+          image: {{ registry_pod_image_repo | default(registry_image_repo) }}:{{ registry_pod_image_tag | default(registry_image_tag) }}
           imagePullPolicy: {{ k8s_image_pull_policy }}
           command:
           - /bin/registry
diff --git a/roles/kubernetes/node/templates/manifests/nginx-proxy.manifest.j2 b/roles/kubernetes/node/templates/manifests/nginx-proxy.manifest.j2
--- a/roles/kubernetes/node/templates/manifests/nginx-proxy.manifest.j2
+++ b/roles/kubernetes/node/templates/manifests/nginx-proxy.manifest.j2
@@ -19,7 +19,7 @@
   priority: 2000001000
   containers:
   - name: nginx-proxy
-    image: {{ nginx_image_repo }}:{{ nginx_image_tag }}
+    image: {{ nginx_pod_image_repo | default(nginx_image_repo) }}:{{ nginx_pod_image_tag | default(nginx_image_tag) }}
     imagePullPolicy: {{ k8s_image_pull_policy }}
     resources:
       requests:
