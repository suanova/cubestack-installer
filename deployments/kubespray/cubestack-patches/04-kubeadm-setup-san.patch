# patch: 04-kubeadm-setup-san.patch
# 目标: roles/kubernetes/control-plane/tasks/kubeadm-setup.yml
# 加入: 2026-09-28(随 v2.28.0 → v2.32.0 迁移)
# 原因: SAN 检查块(Check apiserver.crt SANs)前先 stat 探测 apiserver.crt 是否存在, 只在证书存在时才做 SAN 比对;丢了则 kubeadm 已运行但证书文件缺失时, SAN 检查读证书硬失败、play 中断。
# 上游吸收判据: 上游 roles/kubernetes/control-plane/tasks/kubeadm-setup.yml 的 SAN 检查块自带 apiserver.crt 存在性守卫(或对证书缺失已有容错)。
# 上游化: 建议提 PR(通用幂等健壮性, 非本环境特有; §3.5 首批为 metallb, 本条为其后候选)。
# ------------------------------------------------------------
--- a/roles/kubernetes/control-plane/tasks/kubeadm-setup.yml
+++ b/roles/kubernetes/control-plane/tasks/kubeadm-setup.yml
@@ -125,6 +125,17 @@
   loop: "{{ kube_apiserver_enable_admission_plugins }}"
   notify: Control plane | Restart apiserver
 
+- name: Kubeadm | Check if apiserver.crt exists
+  stat:
+    path: "{{ kube_cert_dir }}/apiserver.crt"
+    get_attributes: false
+    get_checksum: false
+    get_mime: false
+  register: apiserver_crt_stat
+  when:
+    - kubeadm_already_run.stat.exists
+    - not kube_external_ca_mode
+
 - name: Kubeadm | Check apiserver.crt SANs
   vars:
     apiserver_ips: "{{ apiserver_sans | map('ansible.utils.ipaddr') | reject('equalto', False) | list }}"
@@ -132,6 +143,7 @@
   when:
     - kubeadm_already_run.stat.exists
     - not kube_external_ca_mode
+    - apiserver_crt_stat.stat.exists
   block:
     - name: Kubeadm | Check apiserver.crt SAN IPs
       command:
