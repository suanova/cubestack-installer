# patch: 18-etcd-3.6.16.patch
# 目标: roles/kubespray_defaults/vars/main/checksums.yml
# 加入: 2026-11-05
# 原因: 2026-11 CVE 修复把 etcd 从 v3.6.14 抬到 v3.6.16。kubespray v2.32.0 的 etcd 版本由
#       etcd_supported_versions[kube_major] 从 etcd_binary_checksums 取"文件顺序首个 < 该线上界"的键,
#       树内校验表封顶 3.6.14 ⇒ 不补表时 ETCD_VERSION 与表值不符(check-modules ⑯/⑱ 会红),
#       且二进制下载的 etcd_binary_checksum 查表缺失。补 arm64/amd64 两行并插在表首,
#       保持上游 "首键 = 默认版本" 语义。sha256 来源: 官方 v3.6.16 SHA256SUMS 的
#       etcd-v3.6.16-linux-{amd64,arm64}.tar.gz 行(2026-10-22 发布)。
# 上游吸收判据: etcd_binary_checksums 出现 >=3.6.16 条目(换树自带新版表即退休)
# 上游化: 不提 PR(升级到上游尚未支持的版本属本地版本钉; 换树时由 --check-retired 判定退休)
# ------------------------------------------------------------
--- a/roles/kubespray_defaults/vars/main/checksums.yml
+++ b/roles/kubespray_defaults/vars/main/checksums.yml
@@ -381,6 +381,7 @@
     1.34.0: sha256:7201ba36f44187f408a036c4a545e2a3cd12943b1297092687bb66c9a1a9fed6
 etcd_binary_checksums:
   arm64:
+    3.6.16: sha256:ad756ff27ba21e3488cfb84d00f3f4ad8d9b60a93e20f5be5b230a4aab1dc053
     3.6.14: sha256:fa1b80565ee6fc2df1ae6f57a508b221f3ecc7d591c317c581cd8281b0842b3e
     3.6.13: sha256:5ab53ff70301fa9d782fa4b59fdfc1fae49ffdf427a0afb3cd313a93449800fc
     3.6.12: sha256:147afc710e164fa342ad8561bcca8903f3913bd9fb9ae0c83c857b1d868189cc
@@ -425,6 +426,7 @@
     3.5.7: sha256:1a35314900da7db006b198dd917e923459b462128101736c63a3cda57ecdbf51
     3.5.6: sha256:888e25c9c94702ac1254c7655709b44bb3711ebaabd3cb05439f3dd1f2b51a87
   amd64:
+    3.6.16: sha256:c8c0d96d8292ef085deabbf735e9561d3d396768e4d606df005aa25964f21911
     3.6.14: sha256:ffe840ff9295808e88cce2794a18a5ac87f12a5203c8314d0bf6aa119b41bac5
     3.6.13: sha256:b4928654aed84d90952620c7144555e4186d795e1e7414e65fe0cf6265fd0465
     3.6.12: sha256:d2564bb50b58e52fbaf3bde4a9561a1d04e20cdc761f795580e4d615d5d41355
