# patch: 06-metallb-crd-race.patch
# 目标: roles/kubernetes-apps/metallb/tasks/main.yml
# 加入: 2026-09-28(随 v2.28.0 → v2.32.0 迁移)
# 原因: 裸金属新集群首装 metallb 的 CRD 注册竞态(Established 等待 + controller rollout restart + apply 重试);丢了则池子 CR 无法被 controller 处理, LB 永远分不到 VIP。
# 上游吸收判据: roles/kubernetes-apps/metallb/tasks/main.yml 中出现 Established 等待或 apply retries
# 上游化: 建议提 PR(见 docs/kubespray-upgrade.md 的"待上游化"清单)
# ------------------------------------------------------------
--- a/roles/kubernetes-apps/metallb/tasks/main.yml
+++ b/roles/kubernetes-apps/metallb/tasks/main.yml
@@ -38,6 +38,36 @@
   when:
     - inventory_hostname == groups['kube_control_plane'][0]
 
+# ── 根因修复(裸金属 metallb 部署竞态): ──────────────────────────────────
+# metallb.yaml 一次性 apply CRD + controller, controller 可能早于 CRD 在
+# apiserver 注册前启动, informer 报 "no matches for kind IPAddressPool" 且不自动恢复
+# → 池子 CR 即使创建也无法被 controller 处理 → LB 永远分不到 VIP。
+# 修复: 等 CRD Established 后重启 controller, 保证 informer 在 CRD 之后连接。
+# ──────────────────────────────────────────────────────────────────────
+- name: MetalLB | Wait for IPAddressPool CRD to be established
+  command: "{{ bin_dir }}/kubectl wait --for=condition=Established crd/ipaddresspools.metallb.io --timeout=60s"
+  register: metallb_crd_wait
+  until: metallb_crd_wait is succeeded
+  retries: 6
+  delay: 5
+  changed_when: false
+  become: true
+  when:
+    - inventory_hostname == groups['kube_control_plane'][0]
+
+- name: MetalLB | Restart controller so informers start after CRDs established
+  command: "{{ bin_dir }}/kubectl -n {{ metallb_namespace }} rollout restart deployment -l app=metallb,component=controller"
+  changed_when: false
+  become: true
+  when:
+    - inventory_hostname == groups['kube_control_plane'][0]
+
+- name: MetalLB | Wait for controller rollout after restart
+  command: "{{ bin_dir }}/kubectl rollout status -n {{ metallb_namespace }} deployment -l app=metallb,component=controller --timeout=2m"
+  become: true
+  when:
+    - inventory_hostname == groups['kube_control_plane'][0]
+
 - name: MetalLB | Address pools
   when:
     - inventory_hostname == groups['kube_control_plane'][0]
@@ -56,6 +86,14 @@
         kubectl: "{{ bin_dir }}/kubectl"
         filename: "{{ kube_config_dir }}/pools.yaml"
         state: "{{ pools_rendering.changed | ternary('latest', 'present') }}"
+      register: metallb_pools_result
+      # 新集群刚拉起时 apiserver→webhook-service 的 ClusterIP 路由(calico/kube-proxy)
+      # 可能尚未收敛, 且 controller 的 webhook(9443)启动晚于 metrics 就绪探针,
+      # 首次 apply 会因 webhook 调用超时而失败(池未持久化); 重试吸收该瞬时窗口。
+      # 见 cubestack-installer 对裸金属环境 metallb 超时问题的修复。
+      until: metallb_pools_result is succeeded
+      retries: "{{ metallb_apply_retries | default(10) }}"
+      delay: "{{ metallb_apply_retry_delay | default(5) }}"
       become: true
 
 - name: MetalLB | Layer2
@@ -76,6 +114,10 @@
         kubectl: "{{ bin_dir }}/kubectl"
         filename: "{{ kube_config_dir }}/layer2.yaml"
         state: "{{ layer2_rendering.changed | ternary('latest', 'present') }}"
+      register: metallb_layer2_result
+      until: metallb_layer2_result is succeeded
+      retries: "{{ metallb_apply_retries | default(10) }}"
+      delay: "{{ metallb_apply_retry_delay | default(5) }}"
       become: true
 
 - name: MetalLB | Layer3
@@ -96,6 +138,10 @@
         kubectl: "{{ bin_dir }}/kubectl"
         filename: "{{ kube_config_dir }}/layer3.yaml"
         state: "{{ layer3_rendering.changed | ternary('latest', 'present') }}"
+      register: metallb_layer3_result
+      until: metallb_layer3_result is succeeded
+      retries: "{{ metallb_apply_retries | default(10) }}"
+      delay: "{{ metallb_apply_retry_delay | default(5) }}"
       become: true
 
 
