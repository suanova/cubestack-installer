# ============================================================
# 外部 CephFS 宿主机挂载专用配置(cephfs_mount 模块; external 模式)
# ------------------------------------------------------------
# 用途: 只做“把外部 CephFS 的某个子目录挂到每台节点 /mnt/cephfs/models”,
#   不要求把外部 Ceph 接入本集群的 CSI/StorageClass。
#
# 用法:
#   cp deployments/config/external-cephfs.env.example deployments/config/external-cephfs.env
#   chmod 600 deployments/config/external-cephfs.env
#   # 填入真实 mon/FS/只读用户 key 后:
#   sudo CEPH_MODE=external CEPHFS_MOUNT_ENABLED=true \
#     ./deployments/scripts/deploy-cluster.sh --steps cephfs_mount
#
# ⚠ 本文件含 cephx key, 已在 .gitignore 中忽略, 不得提交/打进镜像。
# ⚠ 只读 key 的 caps 需覆盖要挂载的路径(如 allow r path=/models); 子目录必须已存在。
# ============================================================

# mon 地址(逗号分隔; 内核 ceph 客户端会从中选一个可达的)
CEPH_MONITORS="10.66.3.46:6789"

# 外部 CephFS 名(如 cephfs / cubestack-ext-fs)
CEPHFS_FS="cephfs"

# 挂载用户(只读示例: 提供方分配的 client.linux-host-ro → 这里不带 client. 前缀)
CEPHFS_NODE_USER="linux-host-ro"
# 该用户的 cephx key(裸 key, 不带 [client.xxx] 段名)
CEPHFS_NODE_KEYRING="<REPLACE_WITH_CEPHX_KEY>"

# true = mount -o ro; 不创建子目录(要求已存在); 验证只读 + ls
CEPHFS_MOUNT_READ_ONLY="true"

# 可选覆盖(默认 /mnt/cephfs/models 与 models)
# CEPHFS_MOUNT_PATH="/mnt/cephfs/models"
# CEPHFS_MOUNT_SUBDIR="models"

# 可选: 镜像为空时模块自动取集群 cephfs CSI nodeplugin 镜像; 无 CSI 的集群显式指定
# CEPHFS_MOUNT_IMAGE="harbor.isuanova.com/mirrors/quay.io/cephcsi/cephcsi:v3.17.0"
