# ============================================================
# images.manifest — CubeStack 全量镜像清单(**唯一数据源**)
# ============================================================
# 用途: 声明本仓库部署所需的**所有上游原始镜像**。三处消费, 全部读本文件:
#   ① CI   : .github/workflows/sync-images-to-harbor.yml → tools/images/harbor-sync-images.sh
#             把每个镜像从上游同步到 Harbor(harbor.isuanova.com/mirrors/**, 项目不存在自动创建)
#   ② 联网机: tools/images/harbor-save-images.sh   → 从 Harbor 拉取并保存成离线 tar
#   ③ 部署机: 模块读 deployments/offline-files/<group>/ 下的 tar 推入集群内置 registry
#
# ── 格式(每行; # 开头为注释; 空行忽略) ──────────────────────
#     <group>   <上游镜像 ref>   [tar 文件名覆盖]
#   · 前三列以空白分隔, 第三列**可选**(省略时按 ref 自动派生 tar 名)。
#   · group = 离线目录分组, 对应 deployments/offline-files/<group>/
#     (少数 group 有目录覆盖, 见 tools/images/lib-image-manifest.sh 的 image_group_dir())
#   · ref 支持 ${VAR} 占位符 —— 取值来自 deployments/config/cluster.conf
#     (CI 上没有 cluster.conf 时自动回退 cluster.conf.example 的内置默认值)。
#     ⇒ **升级版本只改 cluster.conf 一处**, 本文件与 CI/Harbor 自动跟随。
#   · ref 必须**全限定**(带注册域), 短名(busybox/nginx)一律补 docker.io/library/。
#   · 第 3 列用于"历史短名"镜像: 既有模块按字面文件名读取(如 22_verify_registry_storage.sh
#     读 busybox.tar、ensure_registry_nginx 读 nginx.tar), 这类 tar 不能按 ref 改名。
#
# ── Harbor 目标路径规则(唯一规则, 见 lib-image-manifest.sh 的 image_mirror_ref) ──
#     mirrors/<注册域>/<仓库路径>:<tag>         上游注册域 ≠ Harbor 时
#     mirrors/<仓库路径>:<tag>                  上游就在同一台 Harbor 上时(去掉域名前缀)
#   例: registry.k8s.io/sig-storage/csi-provisioner:${CSI_PROVISIONER_VERSION}
#         → harbor.isuanova.com/mirrors/registry.k8s.io/sig-storage/csi-provisioner:<tag>
#       harbor.isuanova.com/metax/gpu-label:${METAX_VERSION}-amd64
#         → harbor.isuanova.com/mirrors/metax/gpu-label:${METAX_VERSION}-amd64
#   ⚠ 保留注册域是有意的: 上游 ref 是 Harbor 路径的**后缀**, 因此离线 tar 按上游 ref
#     命名(如 registry.k8s.io_sig-storage_csi-provisioner_v5.1.0.tar)时,
#     各部署模块原有的 *<repo>_<tag>.tar 通配仍然命中, 无需改动匹配逻辑。
#
# ── 特例: "上游就是本台 Harbor"的组(metax-gpu)**默认不镜像** ──
#   它本就在本台 Harbor 上(metax/ 项目), "集群不访公网"的目标**已经达成**
#   —— 对应部署模块现在就直接从那个项目拉取, 无需任何改动。再复制一份到 mirrors/ 只会
#   多占一份存储(实测 8.4 GB)且每次版本升级都要重跑, 故默认跳过。
#   判据是推导的(注册域 == HARBOR_MIRROR_REGISTRY), 不是硬编码名单。
#   真要那份副本: harbor-sync-images.sh --include-same-harbor --group metax-gpu
#   (它仍列在本清单里, 因为清单同时承担"本仓库用到哪些镜像"的登记职责。)
#
# ── 校验 ──────────────────────────────────────────────────
#   bash deployments/scripts/tools/images/check-image-manifest.sh          # 静态校验(格式/变量/重复)
#   bash deployments/scripts/tools/images/check-image-manifest.sh --harbor # 额外比对 Harbor 已有 tag(漂移报告)
# ============================================================

# ------------------------------------------------------------
# [group: k8s-base] kubespray 基座(节点 containerd 预加载)
#   目录: deployments/offline-files/kubespray/images/
#   ⚠ 版本必须与 kubespray 实际解析出的 kube_version / 各 addon 版本一致;
#     升级 K8s 时改 K8S_VERSION。清单来源 = tools/offline/trim-offline-files.sh 的
#     PRELOAD_IMAGE_PATTERNS(两者必须同步: 改了这里也要改那里, 否则镜像会被裁掉)。
# ------------------------------------------------------------
k8s-base  registry.k8s.io/kube-apiserver:${K8S_VERSION}
k8s-base  registry.k8s.io/kube-controller-manager:${K8S_VERSION}
k8s-base  registry.k8s.io/kube-scheduler:${K8S_VERSION}
k8s-base  registry.k8s.io/kube-proxy:${K8S_VERSION}
k8s-base  registry.k8s.io/pause:${PAUSE_VERSION}
k8s-base  registry.k8s.io/coredns/coredns:${COREDNS_VERSION}
k8s-base  registry.k8s.io/dns/k8s-dns-node-cache:${DNS_NODE_CACHE_VERSION}
k8s-base  registry.k8s.io/metrics-server/metrics-server:${METRICS_SERVER_VERSION}
k8s-base  registry.k8s.io/cpa/cluster-proportional-autoscaler:${CPA_VERSION}
k8s-base  quay.io/coreos/etcd:${ETCD_VERSION}
k8s-base  quay.io/calico/cni:${CALICO_VERSION}
k8s-base  quay.io/calico/node:${CALICO_VERSION}
k8s-base  quay.io/calico/kube-controllers:${CALICO_VERSION}
k8s-base  quay.io/metallb/controller:${METALLB_VERSION}
k8s-base  quay.io/metallb/speaker:${METALLB_VERSION}
# kube-vip: 控制平面 API VIP(静态 Pod)。⚠ 必须进 PRELOAD_IMAGE_PATTERNS ——
# kube-vip 在 kubeadm init **之前**就要起来并绑上 VIP, 拉不到镜像会直接卡死首次部署。
# 镜像名不带 -iptables 后缀 = kube_vip_lb_fwdmethod 为 local(kubespray 默认, 本项目也用这个)。
#   ⚠ 但 local 在内核里是 ip_vs_null_xmit(**不转发**)—— 本项目选它 = 选"不开控制面 LB", 不是
#     "用更省的姿势开了 LB"。真要开必须改 masquerade, 届时上例会变成 kube-vip-iptables,
#     此处要加一条 **并且** 同步 PRELOAD_IMAGE_PATTERNS(见 docs/troubleshooting.md 三.11)。
k8s-base  ghcr.io/kube-vip/kube-vip:${KUBE_VIP_VERSION}
k8s-base  docker.io/library/registry:${REGISTRY_IMAGE_TAG}
k8s-base  docker.io/rancher/local-path-provisioner:${LOCAL_PATH_VERSION}
# 验证/工具镜像(verify 模块与 registry 存储校验用; 见 lib-common 的 ensure_registry_nginx)
# ⚠ busybox 用第 3 列锁死文件名: 22_verify_registry_storage.sh 按字面 "busybox.tar" 读取
k8s-base  docker.io/library/busybox:${BUSYBOX_TAG}   busybox.tar

# ------------------------------------------------------------
# [group: nginx] verify 模块测试后端(统一 HTTP 测试服务)
#   目录: deployments/offline-files/nginx/
#   ⚠ 文件名锁死 "nginx.tar": lib-common 的 ensure_registry_nginx 按 nginx*.tar 查找并推入
#     内置 registry 供 verify 模块当测试后端用(不依赖 docker.io, 也不靠节点预载)。
# ------------------------------------------------------------
nginx  docker.io/library/nginx:${NGINX_TAG}   nginx.tar

# ------------------------------------------------------------
# [group: ceph] Rook + Ceph(internal 模式; CEPH_ENABLED / CEPH_CSI_ENABLED)
#   目录: deployments/offline-files/kubespray/images/(与 kubespray 同目录 —— 节点预加载走同一条
#   路径, 见 02_ceph.sh 的 CEPH_IMAGE_DIR=${OFFLINE_FILES_DIR}/images)
#   ⚠ ceph-csi 四件套与 snapshot-controller 也在此: kubespray 的 csi 相关 addon 会用到
# ------------------------------------------------------------
ceph      docker.io/rook/ceph:${ROOK_VERSION}
ceph      quay.io/cephcsi/ceph-csi-operator:${CEPH_CSI_OPERATOR_VERSION}
ceph      quay.io/ceph/ceph:${CEPH_VERSION}
ceph      quay.io/cephcsi/cephcsi:${CEPHCSI_VERSION}
ceph      quay.io/csiaddons/k8s-sidecar:${CSIADDONS_SIDECAR_VERSION}
ceph      registry.k8s.io/sig-storage/csi-attacher:${CSI_ATTACHER_VERSION}
ceph      registry.k8s.io/sig-storage/csi-node-driver-registrar:${CSI_NODE_DRIVER_REGISTRAR_VERSION}
ceph      registry.k8s.io/sig-storage/csi-provisioner:${CSI_PROVISIONER_VERSION}
ceph      registry.k8s.io/sig-storage/csi-resizer:${CSI_RESIZER_VERSION}
ceph      registry.k8s.io/sig-storage/csi-snapshotter:${CSI_SNAPSHOTTER_VERSION}
ceph      registry.k8s.io/sig-storage/snapshot-controller:${SNAPSHOT_CONTROLLER_VERSION}

# ------------------------------------------------------------

# ------------------------------------------------------------

# ------------------------------------------------------------

# ------------------------------------------------------------

# ------------------------------------------------------------

# ------------------------------------------------------------

# ------------------------------------------------------------
# [group: multus] Multus CNI(容器多网卡)
#   目录: deployments/offline-files/multus/
# ------------------------------------------------------------
multus  ghcr.io/k8snetworkplumbingwg/multus-cni:${MULTUS_IMAGE_TAG}

# ------------------------------------------------------------
# [group: rdma] RDMA 共享设备插件
#   目录: deployments/offline-files/rdma/
#   ⚠ 官方源已迁 ghcr.io/mellanox(Docker Hub 无此镜像); 1.4.0 无 v 前缀, v1.5.1+ 带 v
# ------------------------------------------------------------
rdma  ghcr.io/mellanox/k8s-rdma-shared-dev-plugin:${RDMA_IMAGE_TAG}

# ------------------------------------------------------------
# [group: netshoot] 网络/RDMA 诊断 pod 的镜像(模块 netshoot / deployments/scripts/modules/03_addon/35_netshoot.sh)
#   目录: deployments/offline-files/netshoot/
#   · 下表只有**上游 netshoot**(自建镜像的底座): 由 CI 同步到 Harbor, 联网机构建自建镜像时可用。
#   · ⚠ **自建派生镜像 netshoot-rdma:<perftest 版本> 不登记在本清单** —— 它不对应任何上游镜像,
#     CI 无从同步。由 tools/images/netshoot-rdma-build.sh 在**联网机**构建(产物 tar 直接放
#     offline-files/netshoot/), 模块 35 推入集群内置 registry。
#     ⇒ 升级: 改 cluster.conf 的 NETSHOOT_RDMA_VERSION(该值 = perftest 版本)后重建镜像再重跑模块。
#   · 原始 netshoot tar(offline-files/os/netshoot.tar)仍是**回退路径**: 自建 tar 缺失时模块用它,
#     pod 照常起但没有 ibv_*/perftest(会告警)。
# ------------------------------------------------------------
netshoot  docker.io/nicolaka/netshoot:latest

# ------------------------------------------------------------
# [group: lws] LeaderWorkerSet(多机推理编排)
#   目录: deployments/offline-files/lws/
# ------------------------------------------------------------
lws  registry.k8s.io/lws/lws:${LWS_IMAGE_TAG}

# ------------------------------------------------------------
# [group: metax-gpu] 沐曦 GPU Operator
#   目录: deployments/offline-files/metax-gpu/
#   ⚠ **本组默认不镜像到 mirrors/**: 沐曦不发布到公共 registry, 上游就是本台 Harbor 的
#     metax 项目 —— 部署模块直接从 harbor.isuanova.com/metax/ 拉取,
#     再复制一份只多占 8.4 GB(其中 maca 5.3 GB、driver-image 1.15 GB)且升级要重跑。
#   ⚠ 镜像 tag 带 -amd64 架构后缀(沐曦约定, 模块会把核心组件去后缀), 不要"修正"。
#   组件清单与 METAX_IMAGE_COMPONENTS 对应; driver/maca 版本另有变量:
# ------------------------------------------------------------
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/gpu-label:${METAX_VERSION}-amd64
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/gpu-device:${METAX_VERSION}-amd64
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/gpu-aware:${METAX_VERSION}-amd64
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/topo-master:${METAX_VERSION}-amd64
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/topo-worker:${METAX_VERSION}-amd64
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/operator-controller:${METAX_VERSION}-amd64
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/container-runtime:${METAX_VERSION}-amd64
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/driver-manager:${METAX_VERSION}-amd64
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/gpu-scheduler:${METAX_VERSION}-amd64
# ★ 2026-09-24: 移除 mx-exporter —— dataExporter 已随可观测性栈整体移除(chart 默认
#   dataExporter.deploy=false, 模块也不再 --set 打开), 该镜像不再需要
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/driver-image:${METAX_DRIVER_VERSION}
# maca: METAX_MACA_IMAGE 本身已含 "仓库名:tag"(maca:3.8.1.2-ubuntu22.04-amd64), 故整体拼接
metax-gpu  ${METAX_HARBOR}/${METAX_PROJECT}/${METAX_MACA_IMAGE}
