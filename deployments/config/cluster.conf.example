# ============================================================
# CubeStack 集群统一配置文件 —— 示例模板(提交到仓库)
# 复制为 config/cluster.conf 后按实际环境修改(真实配置已 gitignore):
#   cp config/cluster.conf.example config/cluster.conf
# ============================================================
#
# ╔════════════════════════════════════════════════════════════════════════╗
# ║ ⚠⚠⚠  核心必改项(部署前必须核对, 否则部署失败/异常)  ⚠⚠⚠            ║
# ╠════════════════════════════════════════════════════════════════════════╣
# ║ ① SSH_DEFAULT_PASSWORD  节点 SSH 默认密码(NODES 中密码为 "-" 时使用)   ║
# ║ ② NODES                集群节点(role,hostname,ip,ssh_user,ssh_password)║
# ║ ③ METALLB_POOL         MetalLB 负载均衡地址池(与节点同二层且空闲)      ║
# ║                                                                        ║
# ║ · 裸金属集群: 必须手动填 NODES 全部节点 + METALLB_POOL 物理网段空闲段   ║
# ║ · 虚拟机集群: NODES 由 tools/vm/create-vms.sh 自动注入, 通常无需手改;   ║
# ║   METALLB_POOL 由 create-vms.sh 自动推导为 VM 网段                      ║
# ║ · 多集群共用网段时: 务必避开其他集群已用的 LB IP(见 3.1 冲突提示)        ║
# ╚════════════════════════════════════════════════════════════════════════╝
#
# ---- ① 节点 SSH 默认密码(必改) ----
SSH_DEFAULT_PASSWORD="${SSH_DEFAULT_PASSWORD:-CHANGE_ME}"
#   注: NODES 每行最后一位 ssh_password 为 "-" 时, 用本默认密码; 显式写密码则用该密码。

# ---- ② 集群节点(必改; 5字段: role,hostname,ip,ssh_user,ssh_password) ----
#   role: master | worker;  ssh_password: "-"=用 SSH_DEFAULT_PASSWORD, 显式=该节点密码
#   ⚠ 虚拟机规格不在本文件: 需创建虚拟机的节点在 tools/vm/vm-nodes.conf(10字段)定义
NODES=(
  "master,cubestack-k8s-master01,10.244.1.11,ubuntu,-"
  "worker,cubestack-k8s-worker01,10.244.2.11,ubuntu,-"
  "worker,cubestack-k8s-worker02,10.244.2.12,ubuntu,-"
)

# ---- ③ MetalLB 地址池(必改; 见 3.1 详细说明) ----
#   池内 IP 与节点同一二层网络且空闲; 多集群务必避免与其他集群 LB IP 冲突
METALLB_POOL="10.66.1.131-10.66.1.132"   # ⚠ 必须排除已被其他集群/主机占用的地址(曾用 130-139 把 registry 分到别的集群 VIP 导致镜像拉取失败)

# ════════════════════════════════════════════════════════════
# ★★ 组件启停开关(全部集中在此, 一键启停; 按阶段分组) ★★
# 设 1/true 启用, 0/false 关闭。只改这里即可启停组件, 不用翻各阶段配置。
# 各组件详细参数仍在下方对应阶段(此块只保留开关, 避免两处维护)。
# ════════════════════════════════════════════════════════════

# ---- 服务暴露方式(全局开关; 决定 registry/ingress-nginx/Envoy Gateway 的对外暴露形态) ----
# 支持参数(默认二选一, 互斥 —— 要么 nodeport 要么 metallb, 不能同时):
#   nodeport(默认) = NodePort 暴露(不依赖 MetalLB 与 L2 同网段空闲 IP; 外部访问 <任一节点IP>:<NodePort>)
#                   · 自动关闭 MetalLB; registry → NodePort(REGISTRY_NODEPORT 31148)
#                   · ingress-nginx(若启用) → NodePort(30080/30081)
#                   · Envoy Gateway 数据面 → NodePort(已创建的 Gateway 用 tools/lb/gateway-nodeport.sh 转换)
#   metallb         = MetalLB LoadBalancer VIP 暴露(生产; 需 METALLB_POOL 提供同网段空闲 IP)
#                   · registry 固定 VIP / ingress 80,443 / EG 数据面 VIP
# 大小写不敏感: 任意大小写组合均接受(判断前先 tr 转小写, 如 nodeport/NodePort/nodePort/NODEPORT
#   统一归一化为 nodeport); 其它任何值(如 loadbalancer)一律归一化为 metallb。
# ⚠ nodeport 模式(默认, 自动连通, 无需手动配置): 默认通过**集群第一个 IP(首个 master)**访问内置服务 ——
#   REGISTRY_IP 自动 = 首个 master IP; 节点 containerd 经 hosts.toml 镜像直连 <首个master>:REGISTRY_NODEPORT
#   拉取 registry.cubestack.io 镜像(客户端侧改写, 不依赖节点 iptables); 宿主机 registry.cubestack.io:5000 由
#   deploy-registry.sh 自动 DNAT 到首个 master 的 REGISTRY_NODEPORT(systemd 持久化)。
#   显式设 REGISTRY_IP 可覆盖; 集群外 push 另见 REGISTRY_EXPOSE_HOST / ENVOY_PUSH_ENDPOINT(阶段三 3.2)。
# 各服务仍可单独覆盖: REGISTRY_SERVICE_TYPE(见阶段三 3.2); ingress-nginx 在 kubespray addons.yml。
SERVICE_EXPOSE_MODE="${SERVICE_EXPOSE_MODE:-nodePort}"

# ---- 阶段一、宿主机环境 ----
HAPROXY_ENABLED="${HAPROXY_ENABLED:-false}"             # API 四层负载均衡(modules/01_env/05_lb_haproxy.sh; 默认 master 直连, 需要时开)
                                                        #   ⚠ 在 HAProxy 所在服务器上执行本模块(持久化机器), 非临时 installer 服务器(装完即删)
KEEPALIVED_ENABLED="${KEEPALIVED_ENABLED:-false}"       # API VIP 高可用(modules/01_env/06_lb_keepalived.sh)
HARBOR_ENABLED="${HARBOR_ENABLED:-false}"               # Harbor 外部镜像仓库(预留, 见 1.7)

# ---- 阶段二、kubespray 基座 ----
UPDATE_ETC_HOSTS="${UPDATE_ETC_HOSTS:-0}"               # 部署时更新宿主机 /etc/hosts 节点解析(默认关; 1 开)
NTP_ENABLED="${NTP_ENABLED:-1}"                         # 节点时间同步(0=跳过, 不推荐; 见 2.2)
K8S_ENABLED="${K8S_ENABLED:-false}"                     # 部署 kubespray 基座(modules/02_k8s/06_k8s_deploy.sh, = --with-k8s)
K8S_SCALE_ENABLED="${K8S_SCALE_ENABLED:-false}"         # 扩容模块(modules/02_k8s/07_k8s_scale.sh, = --with-scale)
METALLB_ENABLED="${METALLB_ENABLED:-true}"              # MetalLB 负载均衡(依赖 3.1 地址池; 需 strict_arp)
LOCAL_PATH_ENABLED="${LOCAL_PATH_ENABLED:-true}"        # local-path-provisioner 默认 StorageClass
METRICS_SERVER_ENABLED="${METRICS_SERVER_ENABLED:-true}"  # metrics-server(HPA 依赖)
HELM_ENABLED="${HELM_ENABLED:-true}"                    # Helm(registry 等组件依赖)
INGRESS_NGINX_ENABLED="${INGRESS_NGINX_ENABLED:-false}" # ingress-nginx(HTTP 入口, 需 MetalLB 或 hostNetwork)
DASHBOARD_ENABLED="${DASHBOARD_ENABLED:-false}"         # Kubernetes dashboard
CERT_MANAGER_ENABLED="${CERT_MANAGER_ENABLED:-false}"   # cert-manager(证书签发; LWS cert-manager 模式依赖)
GATEWAY_API_ENABLED="${GATEWAY_API_ENABLED:-false}"     # Gateway API CRDs

# ---- 阶段三、集群基础设施 ----
REGISTRY_ENABLED="${REGISTRY_ENABLED:-1}"               # 集群内置 Registry(默认部署; 0=不部署 addon/节点信任, 见 3.2)

# ---- 阶段四、附加组件(operator) ----
GPU_OPERATOR_ENABLED="${GPU_OPERATOR_ENABLED:-true}"    # 沐曦 GPU Operator(默认启用; 见 4.1)
LWS_ENABLED="${LWS_ENABLED:-false}"                     # LeaderWorkerSet(LLM 工作负载调度; 见 4.2)
LWS_DISAGGREGATEDSET_ENABLED="${LWS_DISAGGREGATEDSET_ENABLED:-true}"  # LWS DisaggregatedSet(解耦推理; 见 4.2)
PROMETHEUS_ENABLED="${PROMETHEUS_ENABLED:-false}"       # Prometheus+Operator 监控(P1; 见 4.3)
CEPH_ENABLED="${CEPH_ENABLED:-false}"                   # Ceph 存储底座(P1; 见 4.3)
CEPH_CSI_ENABLED="${CEPH_CSI_ENABLED:-false}"           # Ceph CSI RBD/RGW/CephFS(依赖 CEPH_ENABLED; 见 4.3)
ENVOY_GATEWAY_ENABLED="${ENVOY_GATEWAY_ENABLED:-true}" # Envoy Gateway 通用 K8s 网关基座(P1; 见 4.3)
ENVOY_AI_GATEWAY_ENABLED="${ENVOY_AI_GATEWAY_ENABLED:-true}"  # Envoy AI Gateway(LLM/AI 专用, 依赖 EG; 见 4.3)
KEYCLOAK_ENABLED="${KEYCLOAK_ENABLED:-false}"           # 统一认证(P2; 见 4.4)
KUEUE_ENABLED="${KUEUE_ENABLED:-false}"                 # 队列治理(P2; 见 4.4)
KUBEVIRT_ENABLED="${KUBEVIRT_ENABLED:-false}"           # 虚拟机能力(P2; 见 4.4)
LUSTRE_CSI_ENABLED="${LUSTRE_CSI_ENABLED:-false}"       # Lustre CSI(P3; 见 4.5)
CUBESTACK_APPS_ENABLED="${CUBESTACK_APPS_ENABLED:-false}"  # CubeStack 自研组件(占位; 见 4.6)

# ---- 4.3b Rook/Ceph 配置(详见 docs/ceph-rook.md) ----
# 部署方式: Rook Operator(v1.20.2 manifest, 离线 vendoring 于 deployments/cubestack-addon/rook/)
#   + CephCluster CR(Rook 自建 mon/mgr/osd, 由 modules/03_addon/07_ceph.sh 编排)+ ceph-csi(RBD/CephFS)。
# 存储节点选择: CEPH_NODES 显式列出(hostname, 逗号分隔); 留空 = 全部 NODES 节点(至少 3 台奇数更佳)。
#   模块会先给这些节点打 node label(CEPH_NODE_LABEL), CephCluster 据此只调度到这些节点。
CEPH_NODES="${CEPH_NODES:-}"                      # 部署 Ceph 的节点(hostname 逗号分隔); 空=全部节点
CEPH_NODE_LABEL="${CEPH_NODE_LABEL:-ceph-storage=rook-ceph}"   # 存储节点 label(key=value; 模块自动打标)
CEPH_NAMESPACE="${CEPH_NAMESPACE:-rook-ceph}"     # Rook/Ceph 命名空间
CEPH_VERSION="${CEPH_VERSION:-v20.2.2}"           # Ceph 守护进程镜像 tag
ROOK_VERSION="${ROOK_VERSION:-v1.20.2}"           # Rook operator 版本(manifest 目录名+镜像 tag)
CEPHCSI_VERSION="${CEPHCSI_VERSION:-v3.17.0}"     # cephcsi 驱动镜像 tag
CEPH_CSI_OPERATOR_VERSION="${CEPH_CSI_OPERATOR_VERSION:-v1.0.4}"  # ceph-csi-operator(rook v1.20 必须)
# 裸盘(OSD)策略: auto=模块自动检测每个存储节点的未使用裸盘(推荐, 需求 1);
#   explicit=手工在 CEPH_DATA_DISKS 指定(node:/dev/vdb,/dev/vdc; 逗号分隔多节点, 分号分隔条目)。
CEPH_DATA_DISK_POLICY="${CEPH_DATA_DISK_POLICY:-auto}"
CEPH_DATA_DISKS="${CEPH_DATA_DISKS:-}"            # explicit 策略: 如 "cubestack-k8s-master01:/dev/vdb,/dev/vdc;cubestack-k8s-worker01:/dev/vdb"
CEPH_DETECT_EXCLUDE="${CEPH_DETECT_EXCLUDE:-^(sda|sr0|vda|nbd[0-9]+)$}"   # 自动检测时排除的盘名(正则, 防误选系统盘; nbd* 为 qcow2/NBD 伪设备)
# 高可用与池(replicated 生产缺省: 3 副本 + host failureDomain + min_size 2; 见 docs/ceph-rook.md)
CEPH_MON_COUNT="${CEPH_MON_COUNT:-3}"             # mon 数量(奇数, 默认 3)
CEPH_POOL_REPLICAS="${CEPH_POOL_REPLICAS:-3}"     # 副本数
CEPH_POOL_MIN_SIZE="${CEPH_POOL_MIN_SIZE:-2}"     # min_size(1 台主机宕机池仍可写)
CEPH_OSD_MEMORY_TARGET="${CEPH_OSD_MEMORY_TARGET:-4}"   # 每 OSD 内存目标(GiB; 小盘 4G 足够, 大盘按文档调)
CEPHFS_ENABLED="${CEPHFS_ENABLED:-false}"         # 可选: 启用 CephFS(RWX 共享文件)
CEPH_RGW_ENABLED="${CEPH_RGW_ENABLED:-false}"     # 可选: 启用 RGW/S3 对象存储
# 外部 Ceph 连接(本集群无集群内 CephCluster 时): ceph 模块检测到存储节点<CEPH_MIN_NODES 或
#   CEPH_ENABLED 但无集群内 CephCluster 时, 由 ceph_csi 模块经 ceph-csi-operator 的 CephConnection
#   连接外部 Ceph 集群并创建 StorageClass(跳过集群内 pool/cephfs/rgw 创建)。
CEPH_MIN_NODES="${CEPH_MIN_NODES:-3}"            # 存储节点 < 此值 → 不创建集群内 CephCluster
CEPH_EXTERNAL_MONITORS="${CEPH_EXTERNAL_MONITORS:-}"   # 外部 Ceph monitors, 如 "10.66.1.21:6789,10.66.1.22:6789"; 留空=不使用外部 Ceph
CEPH_EXTERNAL_POOL="${CEPH_EXTERNAL_POOL:-rbd}"  # 外部 Ceph 使用的 RBD pool 名(外部集群已有)
CEPH_EXTERNAL_USER="${CEPH_EXTERNAL_USER:-admin}"   # 外部 Ceph 认证用户(默认 admin)
CEPH_EXTERNAL_KEYRING="${CEPH_EXTERNAL_KEYRING:-}"  # 外部 Ceph 认证 keyring(该用户的 key; 必填, 如 AQCxxx==)
CEPH_DASHBOARD_ENABLED="${CEPH_DASHBOARD_ENABLED:-true}"  # Ceph Dashboard
# 安全确认: CEPH_ENABLED=true 部署时模块会红底列出将用的节点与裸盘并 sleep 60s 供 double-check;
#   核对无误可 CEPH_CONFIRM_SLEEP=0(脚本环境变量)跳过, 生产不建议。
CEPH_CONFIRM_SLEEP="${CEPH_CONFIRM_SLEEP:-60}"
# 离线文件: ceph 镜像 tar(独立脚本 tools/images/ceph-save-images.sh 下载)
CEPH_IMAGE_DIR="${CEPH_IMAGE_DIR:-${REPO_ROOT}/deployments/offline-files/kubespray/images}"   # 默认 kubespray/images(与 k8s 镜像同目录, 不再用独立 offline-files/ceph)
CEPH_ROOK_MANIFEST_DIR="${CEPH_ROOK_MANIFEST_DIR:-${REPO_ROOT}/deployments/cubestack-addon/rook}"
# registry 后端存储: local-path(默认)| ceph-block(CEPH 启用后, registry 的 PVC 改走 ceph RBD)
REGISTRY_STORAGE_CLASS="${REGISTRY_STORAGE_CLASS:-local-path}"

# ============================================================
# 其余配置按阶段组织(顺序即依赖方向):
#   阶段一、宿主机环境 / 阶段二、kubespray 基座 / 阶段三、集群基础设施
#   / 阶段四、附加组件(operator) / 阶段五、离线镜像预加载
# 虚拟机创建/网络变量已移至 tools/vm/vm-nodes.conf(独立管理)。
# ============================================================

# ════════════════════════════════════════════════════════════
# 阶段一、宿主机环境(modules/01_env)              依赖: 无
# ════════════════════════════════════════════════════════════

# ---------------- 1.1 宿主机(Hypervisor) ----------------
# 宿主机物理 IP(留空=自动检测; 各脚本直接引用该全局变量, 不硬编码)
HOST_PHYS_IP="${HOST_PHYS_IP:-}"
# ⚠ 虚拟机创建/网络变量(BASE_IMG/VM_DISK_DIR/VM_SSH_USERS/VM_SUBNET/BRIDGE/NET_MODE/NAT_*)
#   已移至 tools/vm/vm-nodes.conf —— 由 lib-common load_config 自动加载, 此处不再定义。

# ---------------- 1.3 SSH 配置 ----------------
SSH_KEY_DIR="${SSH_KEY_DIR:-${HOME}/.ssh}"
SSH_KEY_NAME="${SSH_KEY_NAME:-cubestack_k8s}"
#   注: 节点默认密码统一用 SSH_DEFAULT_PASSWORD(见核心必改项①); 节点独立密码在 NODES 第5字段显式填写。
#       (旧变量 WORKER_SSH_PASSWORD 已废弃移除, 请勿再配置)

# ---------------- 1.4 节点规划(依赖: 1.3 已就绪) ----------------
# (NODES 已在顶部核心必改项定义; 虚拟机规格见 tools/vm/vm-nodes.conf)

# ---------------- 1.5 节点组(依赖: 1.4 节点; 配合 --only 使用) ----------------
# --only 支持直接指定 group 名(而非逐个 hostname):
#   sudo ./deploy-cluster.sh --with-scale --only new_node
# 展开规则: --only <name> 先检查 NODE_GROUP_<name> 变量, 有则展开为其中的 hostname 列表
NODE_GROUP_new_node="cubestack-k8s-worker02"
# 可定义多组, 逗号分隔:
# NODE_GROUP_gpu_nodes="cubestack-k8s-worker03,cubestack-k8s-worker04"

# ---------------- 1.6 API 负载均衡 / 高可用(依赖: 1.4 节点; 默认关) ----------------
# API 入口高可用: HAPROXY=四层 LB(默认 master 直连, 需要时开启); KEEPALIVED=VIP(留空取 API 地址)
# 开关见顶部【组件启停开关】: HAPROXY_ENABLED / KEEPALIVED_ENABLED
KEEPALIVED_VIP="${KEEPALIVED_VIP:-}"                    # Keepalived VIP(留空=取 APISERVER_ADDRESS)
# K8s API 统一入口域名(跨网段统一访问, 需本地 /etc/hosts 解析): 会写入 kubespray
# apiserver_loadbalancer_domain_name + 证书 SAN, 并同步到各节点 /etc/hosts / 宿主机 ~/.kube/config。
# 留空=默认 k8s-api.cubestack.io; 显式设置则用该域名(如保留 k8s-api.nova.local 老域名)。
API_DOMAIN="${API_DOMAIN:-k8s-api.cubestack.io}"

# ---------------- 1.7 Harbor 镜像仓库(集群外私有仓库, 预留, 未来实现) ----------------
# ⚠ 当前集群镜像仓库统一使用【集群内 docker registry】(见阶段三 3.2, REGISTRY_ENABLED=1)。
#   Harbor(集群外企业级仓库)为**预留配置**: 未来需要外部开发机/CI 直接 push、多集群复用等场景时实现;
#   由 modules/01_env/04_harbor.sh(当前为伪代码占位)实现, 默认关闭, 不影响现有部署。
#   开关见顶部【组件启停开关】: HARBOR_ENABLED(默认关)
HARBOR_DOMAIN="${HARBOR_DOMAIN:-harbor.local}"         # 预留: Harbor 访问域名(需 DNS//etc/hosts 解析)
HARBOR_IP="${HARBOR_IP:-10.244.2.200}"                 # 预留: Harbor 监听地址(宿主机 IP 或网卡地址)
HARBOR_STORAGE_CLASS="${HARBOR_STORAGE_CLASS:-local-path}"  # 预留: 数据持久化 StorageClass(如走集群外则用数据目录)


# ════════════════════════════════════════════════════════════
# 阶段二、kubespray 基座(modules/02_k8s + kubespray addon)  依赖: 阶段一
# ════════════════════════════════════════════════════════════

# ---------------- 2.1 部署路径 / 离线目录 ----------------
# 注意: ${CLUSTER_NAME} 由 lib-common.sh 自动解析(环境变量或默认 cubestack-cluster)
KUBESPRAY_INV_DIR="${KUBESPRAY_INV_DIR:-${REPO_ROOT}/deployments/kubespray/inventory/${CLUSTER_NAME}}"
KUBESPRAY_DIR="${KUBESPRAY_DIR:-${REPO_ROOT}/deployments/kubespray/kubespray}"
# 离线资源缓存根目录(二进制/镜像); 各组件离线子目录: kubespray / metax-gpu / lws / envoy 等
# ⚠ 默认留空: 部署脚本经 lib-common 自动解析为 offline-files/kubespray(内层),
#   fetch-offline-from-minio.sh 默认下载到 offline-files 总根(offline-files/{kubespray,lws,metax-gpu,os});
#   两处解耦, 不需要在此显式设置 OFFLINE_FILES_DIR(显式设置会同时改变 fetch 目标)。
OFFLINE_FILES_DIR="${OFFLINE_FILES_DIR:-}"
# kubespray 离线仓库(镜像 tar + 二进制; 已从 repository/<cluster> 迁到 offline-files/kubespray)
LOCAL_REPO_DIR="${LOCAL_REPO_DIR:-${OFFLINE_FILES_DIR:-${REPO_ROOT}/deployments/offline-files}/kubespray}"
# (UPDATE_ETC_HOSTS 开关已移至顶部【组件启停开关】)

# ---------------- 2.1b 离线文件下载(MinIO, 可选) ----------------
# 离线文件缺失时, 用 tools/offline/fetch-offline-from-minio.sh 从 MinIO 下载到 OFFLINE_FILES_DIR;
# 需要 mc(MinIO Client, 见 Dockerfile-cli)。不配置则手工拷贝离线文件。
#   · ⚠ fetch-offline-from-minio.sh 是部署【前置】工具, 不读本文件 —— 它只读独立的
#     config/minio.conf(模板 minio.conf.example)或 MINIO_* 环境变量(下载时集群配置往往还不存在)。
#   · sync-to-minio.sh / fetch-offline-files.sh 仍读本文件(统一数据源)。
#   · 已有 mc alias(如 minio)时, sync-to-minio.sh / fetch-offline-from-minio.sh 会优先复用,
#     以下 MINIO_* 可留空; 无 alias 时才需填写。
#   · 桶/目录: 推荐默认桶 cubestack-installer、目录 offline-files(与本地 offline-files 同名布局);
#     MINIO_REMOTE_DIR 留空时 sync 侧自动取本地源目录名, fetch 侧默认 offline-files。
MINIO_ALIAS="${MINIO_ALIAS:-minio}"                  # mc alias 名
MINIO_ENDPOINT="${MINIO_ENDPOINT:-}"                 # MinIO 服务地址(如 https://minio.example.com)
MINIO_ACCESS_KEY="${MINIO_ACCESS_KEY:-}"             # AccessKey
MINIO_SECRET_KEY="${MINIO_SECRET_KEY:-}"             # SecretKey
MINIO_BUCKET="${MINIO_BUCKET:-cubestack-installer}"  # 离线文件桶(默认与 fetch/sync 一致)
MINIO_REMOTE_DIR="${MINIO_REMOTE_DIR:-offline-files}"  # 桶内目录(留空=sync 取本地源同名 / fetch 默认 offline-files)

# ---------------- 2.2 NTP 时间同步(依赖: 1.1 宿主机为权威源; k8s 部署前) ----------------
# 由 modules/02_k8s/05_k8s_ntp.sh 执行(k8s 阶段默认启用步, 可重复):
#   · 单节点集群(仅 1 个 master + 0 worker): 无跨节点时间同步需求, **自动跳过 NTP**。
#   · 多节点: **权威时间源 = 第一个 master(默认)**: 首 master 装/配 chrony 服务端
#     (local stratum 10 离线兜底; 可选 NTP_UPSTREAM 公网上游), 其他 master/worker
#     作为 chrony/timesyncd 客户端指向第一个 master。
#     **不再用 installer 所在节点(宿主机 HOST_PHYS_IP)作 NTP 服务器** —— 部署机可能在
#     NAT 后/跨网段, 节点无法可靠访问; 以集群内第一个 master 为权威更稳。
#   · 显式 NTP_SERVER 可覆盖(用户指定权威时间源, 如公司内 NTP)。
#   · 应用时对偏差>1s 的节点一次性 date -s @权威epoch 硬对齐。
#   · 校验门禁: 校验后各节点与权威(首 master)偏差 ≤ NTP_MAX_OFFSET_MS, 超限本步失败 → 中止部署(在 kubespray 前)。
#   · NTP_ALLOW 独立于虚拟/裸金属网络: chrony server 放行子网, 默认空=只允许本机(如多子网节点需
#     填集群节点所在网段, 如 "10.66.1.0/24")。
# 开关见顶部【组件启停开关】: NTP_ENABLED(默认 1=启用)
NTP_SERVER="${NTP_SERVER:-}"                          # 权威时间源 IP; 留空=第一个 master 为权威
NTP_UPSTREAM="${NTP_UPSTREAM:-}"                      # 权威(首 master)的公网上游(如 "pool ntp.aliyun.com iburst"); 留空=离线用本机时钟
NTP_ALLOW="${NTP_ALLOW:-}"                            # chrony server allow 子网(默认空=仅本机; 多子网填 "10.66.1.0/24" 等)
NTP_MAX_OFFSET_MS="${NTP_MAX_OFFSET_MS:-2000}"        # 节点-权威(首 master)最大时钟偏差(毫秒); 超限本步失败 → 中止部署

# ---------------- 2.3 集群内部网络 CIDR(由脚本同步到 kubespray group_vars, 不硬编码) ----------------
KUBE_SERVICE_ADDRESSES="${KUBE_SERVICE_ADDRESSES:-10.233.0.0/18}"
KUBE_PODS_SUBNET="${KUBE_PODS_SUBNET:-10.233.64.0/18}"
NODELOCAL_DNS_IP="${NODELOCAL_DNS_IP:-169.254.25.10}"

# ---------------- 2.4 CNI 网络插件(calico + IPIP, 唯一方案) ----------------
# 本集群网络是 proxy-ARP / 按 IP 转发的虚拟化 fabric(非真实 L2): 只转发节点 IP,
# 不路由 pod CIDR, 且丢弃 UDP 4789(VXLAN 端口)。
#   · 唯一可用方案: Calico + IPIP 封装(外层=节点 IP, fabric 放行 IPIP/proto4)。
#   · calico 由 sync-kubespray-config.sh 固定写: backend=bird + ipip_mode=Always + vxlan_mode=Never + mtu=1480。
#   · (cilium 曾试验: 离线安装可跑通, 但数据面隧道在本 fabric 不可用, 已弃用; kubespray 离线
#     安装代码仍保留在 roles/network_plugin/cilium/, 未来若网络变化可再启用, 需重新加回配置。)
#   由 sync-kubespray-config.sh 同步到 k8s-cluster.yml(kube_network_plugin)与各 k8s-net-*.yml, 不硬编码。
KUBE_NETWORK_PLUGIN="${KUBE_NETWORK_PLUGIN:-calico}"

# ---------------- 2.5 kubespray 附加组件开关(由 sync-addons-config.sh 同步到 addons.yml) ----------------
# 这些开关决定 kubespray 附加组件是否安装; 组件详细配置(地址池/存储类等)仍保留在 addons.yml
# 开关见顶部【组件启停开关】: METALLB_ENABLED / LOCAL_PATH_ENABLED / METRICS_SERVER_ENABLED /
#   HELM_ENABLED / INGRESS_NGINX_ENABLED / DASHBOARD_ENABLED / CERT_MANAGER_ENABLED / GATEWAY_API_ENABLED
# (已移除 metallb controller 钉首 master 的 workaround —— IPIP 数据面保证跨节点 webhook 可达, 无需再钉)


# ════════════════════════════════════════════════════════════
# 阶段三、集群基础设施(addon 基座)              依赖: 阶段二(集群已部署)
# ════════════════════════════════════════════════════════════

# ---------------- 3.1 MetalLB 负载均衡地址池(依赖: METALLB_ENABLED; 池已在顶部必改项定义) ----------------
# ⚠ 网络需求(Layer2 模式, 重要):
#   · 池内 IP 必须与集群节点处于同一二层网络(同一子网), 且必须是空闲地址;
#   · 裸金属集群: **无需 bridge/NAT 网络**(纯物理 L2 直连), 不初始化宿主机网络,
#     LB IP 直接在节点物理网卡 ARP 通告 → 池取节点网段空闲段(当前空闲: 10.66.1.130-139);
#   · 虚拟机集群: 需 bridge(privbr0) 网络, 池取 VM 网段空闲段(如 10.244.2.0/24);
#   · 依赖 kube_proxy_strict_arp=true(已默认开启)。
#   · **DHCP 管理网段时**: 池内 IP 必须先加入 DHCP 服务器排除/保留段(如 ip dhcp excluded-address),
#     否则 DHCP 会把这些 IP 重复分配给其他设备 → 与 LB IP 冲突;
#   · **网络必须放行 UDP 4789(VXLAN)进入所有节点, 尤其首控制面**: 否则跨节点 webhook 回包
#     进不来 → 任何服务的 admission webhook(LB/operator/CRD conversion)都会 "context deadline exceeded";
#     ⚠ **仅裸金属环境需要处理**(已验证: 虚拟机标准网络 webhook/LB 均正常, 无此问题); 物理交换机/管理网段可能拦截 VXLAN 端口 4789。
#   · 若网络开启 DHCP Snooping / IP Source Guard, 需在 speaker 节点接入端口放开
#     (否则 ARP 通告的静态 LB IP 流量会被交换机丢弃)。
#   · ⚠ 多集群共用网段时: 池首地址会默认被第一个集群占用, 后续集群务必显式改 METALLB_POOL
#     / REGISTRY_IP 避开已用 IP(部署时会做服务端口冲突探测并醒目提示)。
#   可写 CIDR 或 起止区间; 与节点/VM 网段冲突会导致 LB 无法通告。
#   (值定义在顶部核心必改项: METALLB_POOL="${METALLB_POOL}", 此处引用, 保持唯一事实来源)
METALLB_POOL="${METALLB_POOL}"   # 引用顶部必改项定义(避免两处维护)

# ---------------- 3.2 集群内 Registry(kubespray addon, 默认部署; 依赖 MetalLB + HELM) ----------------
# 集群内镜像仓库统一使用 kubespray 内置 registry addon,**默认部署**(REGISTRY_ENABLED=1)。
# **所有 operator(GPU/LWS/...)都往它推镜像、节点按域名拉取** → 阶段四的隐含依赖。
# 集群外镜像仓库 Harbor 为预留配置(见阶段一 1.7)。
# 关闭: 顶部【组件启停开关】REGISTRY_ENABLED=0(不部署 addon 及节点信任/DNAT)。
REGISTRY_DOMAIN="${REGISTRY_DOMAIN:-registry.cubestack.io}"   # 内部域名(需本地 /etc/hosts 解析)
# REGISTRY_IP 留空 = sync 自动从 METALLB_POOL 取池内首地址作为 LoadBalancer VIP(换环境只改 METALLB_POOL, 免手改)。
# ⚠ 多集群共用同一网段时, 首地址必然被第一个集群占用 → 后续集群必须显式指定 REGISTRY_IP
#   为一个不冲突的池内空闲地址(如 10.66.1.13x; 用 curl -s http://<候选IP>:5000/v2/ 探测无响应者可用),
#   否则推送/拉取会打到别的集群的 registry(数据看似在、实际本集群 registry 空 → 节点 pull NotFound)。
#   部署时 deploy-registry.sh 会对自动派生的候选 VIP 做服务端口探测并醒目提示冲突。
# 显式设置则用它固定(须在池内、避开 .0/.255) —— 适合要绑定某特定空闲 IP 时。
REGISTRY_IP="${REGISTRY_IP:-}"
REGISTRY_PORT="${REGISTRY_PORT:-5000}"
# registry Service 暴露方式: 留空 = 按 SERVICE_EXPOSE_MODE 自动派生(metallb→loadbalancer, nodeport→nodeport);
#   显式设置可单独覆盖(如生产只让 registry 走 NodePort):
#   loadbalancer = MetalLB 固定 VIP(端口保持标准 5000, 依赖 metallb addon)
#   nodeport     = NodePort 经 kube-proxy 路由(不依赖 MetalLB; 外部用 REGISTRY_NODEPORT 端口, 或宿主 DNAT 5000→nodeport)
#   clusterip    = 仅集群内访问
REGISTRY_SERVICE_TYPE="${REGISTRY_SERVICE_TYPE:-}"
REGISTRY_NODEPORT="${REGISTRY_NODEPORT:-31148}"        # nodeport 模式: 固定 NodePort(30000-32767)
# 宿主机对外 DNAT(默认 0 = 只用 MetalLB VIP, 不做宿主机 NAT): 集群内/节点直接从 registry.cubestack.io(VIP)拉取,
# 无需宿主机转发; 仅当需要"集群外 push → push 机把 registry.cubestack.io 解析到宿主机"时才设 1。
REGISTRY_EXPOSE_HOST="${REGISTRY_EXPOSE_HOST:-0}"


# ════════════════════════════════════════════════════════════
# 阶段四、附加组件(operator)                   依赖: 阶段三(Registry 推镜像)
# ════════════════════════════════════════════════════════════

# ---------------- 4.1 沐曦 GPU Operator(依赖: Registry) ----------------
# 开关见顶部【组件启停开关】: GPU_OPERATOR_ENABLED(默认 true=启用)
# 版本不硬编码: 升级只需改 METAX_VERSION, 其余路径/镜像由本配置派生。
# 资源包来源: 沐曦软件中心 下载 → 云平台工具 → metax-gpu-k8s(<版本>.tar.gz, 内含 metax-k8s-images.<ver>.run + helm charts)
METAX_VERSION="${METAX_VERSION:-0.15.3}"                        # GPU Operator 版本(决定包名/镜像 tag/Chart)
# 沐曦 GPU Operator 离线文件目录: 镜像 tar + 资源包/驱动包/.run 等大文件(默认 offline-files/metax-gpu)
METAX_OFFLINE_DIR="${METAX_OFFLINE_DIR:-${REPO_ROOT}/deployments/offline-files/metax-gpu}"
# 大文件(资源包 tgz / metax-k8s-images.*.run / 驱动 *.run)所在目录(默认 = METAX_OFFLINE_DIR)
METAX_PKG_DIR="${METAX_PKG_DIR:-${METAX_OFFLINE_DIR}}"
METAX_PKG_TGZ="${METAX_PKG_TGZ:-metax-gpu-k8s-package.${METAX_VERSION}.tar.gz}"  # 资源包文件名
# 修复后的 helm chart 目录(deployments/cubestack-addon/metax-gpu-operator 下仅保留该修复版 chart, 直接 helm 安装)
METAX_CHART_DIR="${METAX_CHART_DIR:-${REPO_ROOT}/deployments/cubestack-addon/metax-gpu-operator/metax-operator}"
# 镜像加载方式(默认 tar, 从离线 tar 逐镜像加载推送到集群内置 registry):
#   tar = 从 METAX_OFFLINE_DIR/METAX_IMAGE_DIR 加载离线 tar(需先用 metax-save-images.sh 生成)
#   run = 用 metax-k8s-images.<ver>.run 内嵌镜像直接推送(无需预存 tar, 离线可用)
METAX_IMAGE_MODE="${METAX_IMAGE_MODE:-tar}"
METAX_IMAGE_DIR="${METAX_IMAGE_DIR:-${LOCAL_REPO_DIR}/images}"  # tar 模式: 额外镜像 tar 目录(可配置, 优先用 METAX_OFFLINE_DIR)
METAX_TAR_PATTERN="${METAX_TAR_PATTERN:-metax}"                 # tar 模式: 匹配文件名以区分沐曦镜像
# metax-save-images.sh: 从本地 docker 枚举保存的镜像仓库前缀(正则)。
#   默认 ^harbor.isuanova.com/metax/(内网 Harbor 仓库); 也可选 ^cr\.metax-tech\.com/cloud/(沐曦官方仓库,
#   仅取 cloud 前缀避免 public-* 下的大推理镜像重复)。两者都含同内容镜像, 选其一即可。
METAX_SAVE_PATTERN="${METAX_SAVE_PATTERN:-^harbor\.isuanova\.com/metax/}"
# metax-save-images.sh: 枚举中命中即跳过的镜像(正则; 默认排除 sglang 等大推理镜像)
METAX_SAVE_EXCLUDE="${METAX_SAVE_EXCLUDE:-sglang}"
# 核心组件列表(对应 metax-k8s-images.<ver>.run 内嵌镜像, 与版本配套; METAX_LIST_IMAGES=true 可打印保存命令)
METAX_IMAGE_COMPONENTS="${METAX_IMAGE_COMPONENTS:-gpu-label gpu-device gpu-aware topo-master topo-worker operator-controller container-runtime driver-manager gpu-scheduler mx-exporter}"
# 集群内置 registry 仓库路径(默认 registry.cubestack.io:5000/metax, 即 REGISTRY_DOMAIN:REGISTRY_PORT/metax)
METAX_REGISTRY="${METAX_REGISTRY:-${REGISTRY_DOMAIN}:${REGISTRY_PORT}/metax}"
METAX_NAMESPACE="${METAX_NAMESPACE:-metax-operator}"            # 部署命名空间
METAX_RELEASE_NAME="${METAX_RELEASE_NAME:-metax-gpu-operator}"  # Helm release 名
METAX_CLUSTER_TYPE="${METAX_CLUSTER_TYPE:-k8s}"                 # 集群类型: k8s|k3s(标准 K8s 用 k8s)
# 驱动部署策略: PreferHost=用节点已装内核驱动(默认, 本集群节点已有 3.9.x; 免 driver-image, 避免卸载宿主驱动失败)
#   PreferCloud=Operator 经 DaemonSet 容器化安装驱动(需 driver-image, 会尝试卸载宿主驱动, 卸载失败会 CrashLoop)
METAX_DRIVER_DEPLOY_POLICY="${METAX_DRIVER_DEPLOY_POLICY:-PreferHost}"
METAX_DRIVER_VERSION="${METAX_DRIVER_VERSION:-3.8.1.6-amd64}"  # 内核驱动版本(driver-image:<ver>; 需与本地镜像/离线 tar 匹配)
METAX_MACA_IMAGE="${METAX_MACA_IMAGE:-maca:3.8.1.2-ubuntu20.04-amd64}"  # MXMACA SDK 镜像(最新 3.8, 需与离线 tar/在线拉取匹配)

# ---------------- 4.2 LeaderWorkerSet / LWS(依赖: Registry; LLM 工作负载调度) ----------------
# 开关见顶部【组件启停开关】: LWS_ENABLED(默认 false=关)
# 安装方式(二选一, LWS_INSTALL_MODE):
#   bundle(默认, 推荐)= 官方 manifests.yaml 单文件, kubectl apply --server-side 整体下发
#     (含 namespace+CRD+RBAC+controller+webhook; 逐资源应用不受 helm Secret 1MiB 上限; 证书=internal 自签)
#   helm = 本地 chart(LWS_CHART_DIR, 默认 deployments/cubestack-addon/lws/charts), 支持 cert-manager 模式 / 自定义 values
#   (设 LWS_CERT_MODE=cert-manager 自动切 helm)
LWS_INSTALL_MODE="${LWS_INSTALL_MODE:-bundle}"
LWS_MANIFEST="${LWS_MANIFEST:-${REPO_ROOT}/deployments/cubestack-addon/lws/manifests.yaml}"   # 官方 bundle(离线 vendoring)
# Chart 来源(仅 helm 方式, 三选一):
#   dir = 本地解包目录(默认 LWS_CHART_DIR, 仓库内置官方 v0.10.0 chart)
#   tgz = 本地 chart 压缩包(LWS_CHART_TGZ)
#   oci = 官方 OCI registry(需联网): helm install lws oci://registry.k8s.io/lws/charts/lws --version=<LWS_CHART_VERSION>
LWS_CHART_SOURCE="${LWS_CHART_SOURCE:-dir}"
LWS_CHART_VERSION="${LWS_CHART_VERSION:-v0.10.0}"        # 对应官方 CHART_VERSION
# 离线 helm chart 目录/tgz(默认 deployments/cubestack-addon/lws/charts, 已内置官方 v0.10.0 chart)
LWS_CHART_DIR="${LWS_CHART_DIR:-${REPO_ROOT}/deployments/cubestack-addon/lws/charts}"
LWS_CHART_TGZ="${LWS_CHART_TGZ:-${LWS_CHART_DIR}/lws-chart-v0.10.0.tgz}"
LWS_CHART_OCI="${LWS_CHART_OCI:-oci://registry.k8s.io/lws/charts/lws}"
# 证书管理模式(二选一):
#   internal(默认)= controller 内置自签证书; bundle 方式固定 internal
#   cert-manager = 外部 cert-manager 签发 webhook 证书(仅 helm 方式, 需集群已装 cert-manager; 依赖 2.5 CERT_MANAGER_ENABLED)
LWS_CERT_MODE="${LWS_CERT_MODE:-internal}"
# controller 镜像(离线优先: 本地源 dir/tgz 时强制走本地 docker/离线 tar, 不联网;
#   仅 LWS_CHART_SOURCE=oci 或 LWS_IMAGE_ONLINE=true 才允许在线拉取官方镜像)
LWS_IMAGE_ONLINE="${LWS_IMAGE_ONLINE:-false}"
LWS_IMAGE_REPO="${LWS_IMAGE_REPO:-${REGISTRY_DOMAIN}:${REGISTRY_PORT}/lws/manager}"
LWS_IMAGE_TAG="${LWS_IMAGE_TAG:-v0.10.0}"
# 离线镜像下载(tools/images/lws-save-images.sh): 源镜像(默认官方 registry.k8s.io, 可改内网镜像站)与 tar 保存目录
LWS_IMAGE_SRC="${LWS_IMAGE_SRC:-registry.k8s.io/lws/lws:${LWS_IMAGE_TAG}}"
LWS_SAVE_DIR="${LWS_SAVE_DIR:-${REPO_ROOT}/deployments/offline-files/lws}"
LWS_NAMESPACE="${LWS_NAMESPACE:-lws-system}"            # 部署命名空间
LWS_RELEASE_NAME="${LWS_RELEASE_NAME:-lws}"             # Helm release 名
# (LWS_DISAGGREGATEDSET_ENABLED 开关已移至顶部【组件启停开关】)

# ---------------- 4.3 P1 阶段附加组件(依赖: Registry + 部分依赖 GPU/Ceph) ----------------
# 开关见顶部【组件启停开关】: PROMETHEUS_ENABLED / CEPH_ENABLED / CEPH_CSI_ENABLED /
#   ENVOY_GATEWAY_ENABLED / ENVOY_AI_GATEWAY_ENABLED
# Envoy 网关二件套(P1-9 统一流量入口): Envoy Gateway=通用 K8s API 网关基座;
# Envoy AI Gateway=LLM/AI 专用扩展层(依赖 Envoy Gateway 先装)。详见 docs/envoy-gateway.md

# ---------------- Envoy Gateway / Envoy AI Gateway 配置 ----------------
# Chart 来源(二选一/三选一, 与 LWS 一致; **本地源优先, 默认离线安装**):
#   dir = 本地解包目录(deployments/cubestack-addon/envoy-gateway/{eg,ai})
#   tgz = 本地 chart 压缩包(默认; 仓库只存 tgz 不膨胀, 部署时临时解压)/ oci = 官方 registry(需联网)
ENVOY_EG_CHART_SOURCE="${ENVOY_EG_CHART_SOURCE:-tgz}"       # Envoy Gateway chart 来源: dir|tgz|oci
ENVOY_EG_VERSION="${ENVOY_EG_VERSION:-v1.9.1}"               # Envoy Gateway 版本(控制面 gateway + 数据面 envoy 同 tag)
ENVOY_EG_CHART_DIR="${ENVOY_EG_CHART_DIR:-${REPO_ROOT}/deployments/cubestack-addon/envoy-gateway/eg}"
ENVOY_EG_CHART_TGZ="${ENVOY_EG_CHART_TGZ:-${ENVOY_EG_CHART_DIR}/gateway-helm-${ENVOY_EG_VERSION}.tgz}"
ENVOY_EG_CHART_OCI="${ENVOY_EG_CHART_OCI:-oci://docker.io/envoyproxy/gateway-helm}"
ENVOY_AI_CHART_SOURCE="${ENVOY_AI_CHART_SOURCE:-tgz}"       # Envoy AI Gateway chart 来源: dir|tgz|oci
ENVOY_AI_VERSION="${ENVOY_AI_VERSION:-v1.1.0}"               # Envoy AI Gateway chart 版本 + 控制器镜像 tag(带 v)
ENVOY_AI_API_VERSION="${ENVOY_AI_API_VERSION:-v1beta1}"      # AI CRD apiVersion(aigateway.envoyproxy.io/<v>; v1.0 起 v1beta1)
ENVOY_AI_CHART_DIR="${ENVOY_AI_CHART_DIR:-${REPO_ROOT}/deployments/cubestack-addon/envoy-gateway/ai}"
ENVOY_AI_CHART_OCI="${ENVOY_AI_CHART_OCI:-oci://docker.io/envoyproxy}"   # AI chart OCI 前缀(官方 docker.io; 追加 ai-gateway-crds-helm / ai-gateway-helm)
# 镜像(推送到集群内置 registry, K8s 节点按域名拉取; 离线 tar 由 tools/images/envoy-save-images.sh 生成)
ENVOY_EG_IMAGE_BASE="${ENVOY_EG_IMAGE_BASE:-${REGISTRY_DOMAIN}:${REGISTRY_PORT}/envoyproxy}"   # EG 控制面/数据面镜像前缀
ENVOY_AI_IMAGE_REPO="${ENVOY_AI_IMAGE_REPO:-${REGISTRY_DOMAIN}:${REGISTRY_PORT}/ai-gateway/ai-gateway-controller}"
ENVOY_EG_IMAGE_ONLINE="${ENVOY_EG_IMAGE_ONLINE:-false}"     # 允许在线拉取镜像(仅 oci 源或置 true 才联网)
ENVOY_AI_IMAGE_ONLINE="${ENVOY_AI_IMAGE_ONLINE:-false}"     # 同上(AI 控制器)
ENVOY_SAVE_DIR="${ENVOY_SAVE_DIR:-${REPO_ROOT}/deployments/offline-files/envoy}"   # 离线镜像 tar 目录(save 工具输出)
ENVOY_EG_NAMESPACE="${ENVOY_EG_NAMESPACE:-envoy-gateway-system}"   # EG 部署命名空间
ENVOY_AI_NAMESPACE="${ENVOY_AI_NAMESPACE:-ai-gateway-system}"      # AI 控制器部署命名空间
# CRD chart 命名空间: 默认与控制器合并(CRD 为 cluster-scoped, namespace 仅 helm release 归属;
# 早期独立 ai-gateway-crds 空 ns 易误判废弃, 已合并; 设 ai-gateway-crds 可恢复拆分)
ENVOY_AI_CRDS_NS="${ENVOY_AI_CRDS_NS:-${ENVOY_AI_NAMESPACE}}"

# ---------------- 4.4 P2 阶段附加组件 ----------------
# 开关见顶部【组件启停开关】: KEYCLOAK_ENABLED / KUEUE_ENABLED / KUBEVIRT_ENABLED

# ---------------- 4.5 P3 阶段附加组件 ----------------
# 开关见顶部【组件启停开关】: LUSTRE_CSI_ENABLED

# ---------------- 4.6 自研模块(CubeStack 平台组件) ----------------
# 03_addon/ 下 01~19 为第三方中间件预留, 20 起为 CubeStack 自研模块
# 开关见顶部【组件启停开关】: CUBESTACK_APPS_ENABLED


# ════════════════════════════════════════════════════════════
# 阶段五、离线镜像预加载                         依赖: 2.1 离线目录
# ════════════════════════════════════════════════════════════

# ---------------- 5.1 预加载最小镜像集合 ----------------
# 仅同步"部署 kubespray 最小镜像集合"到节点 containerd,避免全量 rsync 无关镜像
# 格式: 空格分隔的匹配条目; 含 ".tar" 为精确文件名匹配, 否则为文件名包含匹配(匹配 images/ 下 *.tar 文件名)
# 留空 = 全量同步 images/ 目录
# 也可在 inventory/${CLUSTER_NAME}/preload-images.conf 中单独覆盖(standalone 运行 cubestack-offline.sh 时)
PRELOAD_IMAGE_PATTERNS="${PRELOAD_IMAGE_PATTERNS:-calico_cni calico_kube-controllers calico_node etcd kube-apiserver kube-controller-manager kube-proxy kube-scheduler coredns cluster-proportional-autoscaler k8s-dns-node-cache metrics-server pause metallb library_registry local-path-provisioner busybox lws_manager}"
