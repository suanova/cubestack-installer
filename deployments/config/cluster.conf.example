# ============================================================
# CubeStack 集群统一配置文件 —— 示例模板(提交到仓库)
# 复制为 config/cluster.conf 后按实际环境修改(真实配置已 gitignore)
#   cp config/cluster.conf.example config/cluster.conf
# 字段含义见同目录 config/cluster.conf 注释
# ============================================================

# ---------------- 宿主机(Hypervisor) ----------------
# 宿主机物理 IP(留空=自动检测; 各脚本直接引用该全局变量, 不硬编码)
HOST_PHYS_IP="${HOST_PHYS_IP:-}"
BASE_IMG="${BASE_IMG:-${REPO_ROOT}/deployments/virtual-machine/cloud-images/ubuntu2204-k8s-base.qcow2}"
VM_DISK_DIR="${VM_DISK_DIR:-/k8s/vm-disks}"

# ---------------- 网络规划 ----------------
NET_MODE="${NET_MODE:-bridge}"          # bridge=方案A(privbr0+精准SNAT) | nat=方案B(libvirt NAT)

# [方案A bridge]
BRIDGE="${BRIDGE:-privbr0}"
BRIDGE_IP="${BRIDGE_IP:-10.244.0.1}"
VM_SUBNET="${VM_SUBNET:-10.244.0.0/16}"
PHYS_WORKER_NET="${PHYS_WORKER_NET:-10.66.1.0/24}"

# [方案B nat]
NAT_NET_NAME="${NAT_NET_NAME:-cubestack-nat}"
NAT_SUBNET="${NAT_SUBNET:-10.245.0.0/16}"
NAT_GATEWAY="${NAT_GATEWAY:-10.245.0.1}"

# ---------------- NTP 时间同步(集群节点时钟一致化, k8s 部署前) ----------------
# 由 modules/02_k8s/05_k8s_ntp.sh 执行(k8s 阶段默认启用步, 可重复):
#   · 权威时间源 = 宿主机(默认): host 装 chrony 并 allow 集群全部网段; 无公网上游时
#     local stratum 10 以本机时钟兜底(离线优先)。
#   · 各节点指向权威: VM(黄金镜像已装 chrony)改写 chrony.conf; 裸金属用 systemd-timesyncd;
#     应用时偏差>1s 的节点一次性 date -s @宿主epoch 硬对齐。
#   · 校验门禁: 校验后全节点与宿主机偏差 ≤ NTP_MAX_OFFSET_MS, 超限本步失败 → 中止部署(在 kubespray 前)。
NTP_ENABLED="${NTP_ENABLED:-1}"                       # 0=跳过时间同步(不推荐)
NTP_SERVER="${NTP_SERVER:-}"                          # 权威时间源 IP; 留空=宿主机(HOST_PHYS_IP)为权威
NTP_UPSTREAM="${NTP_UPSTREAM:-}"                      # 权威的公网上游(如 "pool ntp.aliyun.com iburst"); 留空=离线用本机时钟
NTP_ALLOW="${NTP_ALLOW:-${VM_SUBNET} ${PHYS_WORKER_NET} ${NAT_SUBNET}}"  # chrony server allow 子网(bridge/nat 全覆盖)
NTP_MAX_OFFSET_MS="${NTP_MAX_OFFSET_MS:-2000}"        # 节点-权威最大时钟偏差(毫秒); 超限本步失败 → 中止部署

# ---------------- SSH 配置 ----------------
SSH_KEY_DIR="${SSH_KEY_DIR:-${HOME}/.ssh}"
SSH_KEY_NAME="${SSH_KEY_NAME:-cubestack_k8s}"
SSH_DEFAULT_PASSWORD="${SSH_DEFAULT_PASSWORD:-CHANGE_ME}"
VM_SSH_USERS="${VM_SSH_USERS:-root ubuntu}"
WORKER_SSH_PASSWORD="${WORKER_SSH_PASSWORD:-}"

# ---------------- 节点规划 ----------------
# 格式: role,hostname,ip,mac,mem_g,cpu,disk_g,ssh_user,ssh_password,node_type
#   role: master | worker
#   node_type: vm=虚拟机(自动创建+启动) | bm=裸金属(不创建VM, 走密码连通+装包)
#   省略 node_type 时回退推断: master 默认 vm; 其余按是否有 VM 参数(mac 非"-"且 内存>0)
#   mac: 显式或"-"(自动); 密码"-"=用默认
NODES=(
  "master,cubestack-k8s-master01,10.244.1.11,52:54:00:3b:e9:d2,16,8,100,ubuntu,-,vm"
  "master,cubestack-k8s-master02,10.244.1.12,52:54:00:b6:f1:39,16,8,100,ubuntu,-,vm"
  "master,cubestack-k8s-master03,10.244.1.13,52:54:00:49:e2:3d,16,8,100,ubuntu,-,vm"
  "worker,cubestack-k8s-worker01,10.244.1.21,52:54:00:49:e2:3c,16,8,100,ubuntu,-,vm"
)

# ---------------- 节点组(可选, 配合 --only 使用) ----------------
# --only 支持直接指定 group 名(而非逐个 hostname):
#   sudo ./deploy-cluster.sh --with-scale --only new_node
# 展开规则: --only <name> 先检查 NODE_GROUP_<name> 变量, 有则展开为其中的 hostname 列表
NODE_GROUP_new_node="cubestack-k8s-worker02"
# 可定义多组, 逗号分隔:
# NODE_GROUP_gpu_nodes="cubestack-k8s-worker03,cubestack-k8s-worker04"

# ---------------- kubespray / 部署 ----------------
# 注意: ${CLUSTER_NAME} 由 lib-common.sh 自动解析(环境变量或默认 cubestack-cluster)
KUBESPRAY_INV_DIR="${KUBESPRAY_INV_DIR:-${REPO_ROOT}/deployments/kubespray/inventory/${CLUSTER_NAME}}"
KUBESPRAY_DIR="${KUBESPRAY_DIR:-${REPO_ROOT}/deployments/kubespray/kubespray}"
# 离线文件根目录(全局变量, 可切换): 二进制/镜像/离线包统一存放位置
# 优先级: 环境变量 OFFLINE_FILES_DIR > 此处配置 > 内置默认
OFFLINE_FILES_DIR="${OFFLINE_FILES_DIR:-${REPO_ROOT}/deployments/offline-files/kubespray}"
# 离线资源缓存根目录(二进制/镜像); 各组件离线子目录: kubespray / metax-gpu 等
OFFLINE_FILES_DIR="${OFFLINE_FILES_DIR:-${REPO_ROOT}/deployments/offline-files}"
# kubespray 离线仓库(镜像 tar + 二进制; 整体覆盖可用 LOCAL_REPO_DIR)
LOCAL_REPO_DIR="${LOCAL_REPO_DIR:-${OFFLINE_FILES_DIR}/kubespray}"
UPDATE_ETC_HOSTS="${UPDATE_ETC_HOSTS:-0}"

# ---------------- 集群内部网络 CIDR(由脚本同步到 kubespray group_vars, 不硬编码) ----------------
KUBE_SERVICE_ADDRESSES="${KUBE_SERVICE_ADDRESSES:-10.233.0.0/18}"
KUBE_PODS_SUBNET="${KUBE_PODS_SUBNET:-10.233.64.0/18}"
NODELOCAL_DNS_IP="${NODELOCAL_DNS_IP:-169.254.25.10}"

# ---------------- CNI 网络插件(calico + IPIP, 唯一方案) ----------------
# 本集群网络是 proxy-ARP / 按 IP 转发的虚拟化 fabric(非真实 L2): 只转发节点 IP,
# 不路由 pod CIDR, 且丢弃 UDP 4789(VXLAN 端口)。
#   · 唯一可用方案: Calico + IPIP 封装(外层=节点 IP, fabric 放行 IPIP/proto4)。
#   · calico 由 sync-kubespray-config.sh 固定写: backend=bird + ipip_mode=Always + vxlan_mode=Never + mtu=1480。
#   由 sync-kubespray-config.sh 同步到 k8s-cluster.yml(kube_network_plugin)与各 k8s-net-*.yml, 不硬编码。
KUBE_NETWORK_PLUGIN="${KUBE_NETWORK_PLUGIN:-calico}"

# ---------------- 集群内 Registry(kubespray addon, 默认部署) ----------------
# 集群内镜像仓库统一使用 kubespray 内置 registry addon,**默认部署**(REGISTRY_ENABLED=1)。
# 集群外镜像仓库 Harbor 为预留配置(见下方 HARBOR_ENABLED 配置段, 未来实现)。
# 关闭: REGISTRY_ENABLED=0(不部署 addon 及节点信任/DNAT)。
REGISTRY_ENABLED="${REGISTRY_ENABLED:-1}"
REGISTRY_DOMAIN="${REGISTRY_DOMAIN:-registry.local}"   # 内部域名(需本地 /etc/hosts 解析)
# REGISTRY_IP 留空 = sync 自动从 METALLB_POOL 取池内首地址作为 LoadBalancer VIP(换环境只改 METALLB_POOL, 免手改)。
# 显式设置则用它固定(须在池内、避开 .0/.255) —— 适合要绑定某特定空闲 IP 时。
REGISTRY_IP="${REGISTRY_IP:-}"
REGISTRY_PORT="${REGISTRY_PORT:-5000}"
# registry Service 暴露方式(业界常见):
#   loadbalancer = MetalLB 固定 VIP(默认, 端口保持标准 5000, 依赖 metallb addon)
#   nodeport     = NodePort 经 kube-proxy 路由(不依赖 MetalLB; 外部用 REGISTRY_NODEPORT 端口, 或宿主 DNAT 5000→nodeport)
REGISTRY_SERVICE_TYPE="${REGISTRY_SERVICE_TYPE:-loadbalancer}"
REGISTRY_NODEPORT="${REGISTRY_NODEPORT:-31148}"        # nodeport 模式: 固定 NodePort(30000-32767)

# ---------------- Harbor 镜像仓库(集群外私有仓库, 预留配置, 未来实现) ----------------
# ⚠ 当前集群镜像仓库统一使用【集群内 docker registry】(REGISTRY_ENABLED=1, 见上方配置段)。
#   Harbor(集群外企业级仓库)为**预留配置**: 未来需要外部开发机/CI 直接 push、多集群复用等场景时实现;
#   由 modules/01_env/04_harbor.sh(当前为伪代码占位)实现, 默认关闭, 不影响现有部署。
HARBOR_ENABLED="${HARBOR_ENABLED:-false}"              # 预留: Harbor 开关, 默认关闭(未来实现)
HARBOR_DOMAIN="${HARBOR_DOMAIN:-harbor.local}"         # 预留: Harbor 访问域名(需 DNS//etc/hosts 解析)
HARBOR_IP="${HARBOR_IP:-10.244.2.200}"                 # 预留: Harbor 监听地址(宿主机 IP 或网卡地址)
HARBOR_NAMESPACE="${HARBOR_NAMESPACE:-harbor}"         # 预留: 部署命名空间/数据目录
HARBOR_STORAGE_CLASS="${HARBOR_STORAGE_CLASS:-local-path}"  # 预留: 数据持久化 StorageClass(如走集群外则用数据目录)

# ---------------- MetalLB 负载均衡地址池(由脚本同步到 addons.yml, 不硬编码) ----------------
# ⚠ MetalLB 网络需求(Layer2 模式, 重要):
#   · 池内 IP 必须与集群节点处于同一二层网络(同一子网), 且必须是空闲地址;
#   · 裸金属集群: **无需 bridge/NAT 网络**(纯物理 L2 直连), 用 --skip-net 跳过 vm_network,
#     LB IP 直接在节点物理网卡 ARP 通告 → 池取节点网段空闲段(如 10.66.1.130-10.66.1.139);
#   · 虚拟机集群: 需 bridge(privbr0) 网络, 池取 VM 网段空闲段(如 10.244.2.0/24, 默认值);
#   · 依赖 kube_proxy_strict_arp=true(已默认开启)。
#   · **DHCP 管理网段时**: 池内 IP 必须先加入 DHCP 服务器排除/保留段(如 ip dhcp excluded-address),
#     否则 DHCP 会把这些 IP 重复分配给其他设备 → 与 LB IP 冲突;
#   · **网络必须放行 UDP 4789(VXLAN)进入所有节点, 尤其首控制面**: 否则跨节点 webhook 回包
#     进不来 → 任何服务的 admission webhook 都会 "context deadline exceeded";
#     ⚠ **仅裸金属环境需要处理**(已验证: 虚拟机标准网络 webhook/LB 均正常, 无此问题); 物理交换机/管理网段可能拦截 VXLAN 端口 4789。
#   · 若网络开启 DHCP Snooping / IP Source Guard, 需在 speaker 节点接入端口放开
#     (否则 ARP 通告的静态 LB IP 流量会被交换机丢弃)。
#   可写 CIDR 或 起止区间; 与节点/VM 网段冲突会导致 LB 无法通告。
#   ⚠ 用 CIDR(如 10.244.2.0/24)会包含 .0/.255(网络/广播地址), MetalLB 默认不跳过; 建议用区间排除 .0/.255。
METALLB_POOL="${METALLB_POOL:-10.244.2.1-10.244.2.254}"

# ---------------- 组件开关(统一数据源, 由 sync-addons-config.sh 同步到 kubespray addons.yml) ----------------
# 这些开关决定 kubespray 附加组件是否安装; 组件详细配置(地址池/存储类等)仍保留在 addons.yml
METALLB_ENABLED="${METALLB_ENABLED:-true}"              # MetalLB(负载均衡, 需 kube_proxy_strict_arp=true, 已默认开启)
# (已移除 metallb controller 钉首 master 的 workaround —— IPIP 数据面保证跨节点 webhook 可达, 无需再钉)
LOCAL_PATH_ENABLED="${LOCAL_PATH_ENABLED:-true}"        # local-path-provisioner(默认 StorageClass,**默认启动**; 设为 false 关闭)
METRICS_SERVER_ENABLED="${METRICS_SERVER_ENABLED:-true}"  # metrics-server(HPA 依赖)
HELM_ENABLED="${HELM_ENABLED:-true}"                    # Helm(registry 等组件依赖)
INGRESS_NGINX_ENABLED="${INGRESS_NGINX_ENABLED:-false}" # ingress-nginx(HTTP 入口, 需 MetalLB 或 hostNetwork)
DASHBOARD_ENABLED="${DASHBOARD_ENABLED:-false}"         # Kubernetes dashboard
CERT_MANAGER_ENABLED="${CERT_MANAGER_ENABLED:-false}"   # cert-manager(证书签发)
GATEWAY_API_ENABLED="${GATEWAY_API_ENABLED:-false}"     # Gateway API CRDs

# ---------------- 附加组件开关(控制 deploy-cluster.sh 默认执行哪些 addon 模块) ----------------
# true = deploy-cluster.sh 默认执行对应 modules/ 模块; false = 需 --enable 显式启用
K8S_ENABLED="${K8S_ENABLED:-false}"                      # modules/02_k8s/06_k8s_deploy.sh(= --with-k8s)
K8S_SCALE_ENABLED="${K8S_SCALE_ENABLED:-false}"          # modules/02_k8s/07_k8s_scale.sh(= --with-scale)
GPU_OPERATOR_ENABLED="${GPU_OPERATOR_ENABLED:-false}"   # modules/03_addon/04_gpu_operator.sh(沐曦 GPU Operator; --with-cubestack 或 --enable gpu_operator 启用)

# ---------------- 沐曦 GPU Operator(MetaX)配置 ----------------
# 版本不硬编码: 升级只需改 METAX_VERSION, 其余路径/镜像由本配置派生。
# 资源包来源: 沐曦软件中心 下载 → 云平台工具 → metax-gpu-k8s(<版本>.tar.gz, 内含 metax-k8s-images.<ver>.run + helm charts)
METAX_VERSION="${METAX_VERSION:-0.15.3}"                        # GPU Operator 版本(决定包名/镜像 tag/Chart)
# 沐曦 GPU Operator 离线文件目录: 镜像 tar + 资源包/驱动包/.run 等大文件(默认 offline-files/metax-gpu)
METAX_OFFLINE_DIR="${METAX_OFFLINE_DIR:-${REPO_ROOT}/deployments/offline-files/metax-gpu}"
# 大文件(资源包 tgz / metax-k8s-images.*.run / 驱动 *.run)所在目录(默认 = METAX_OFFLINE_DIR)
METAX_PKG_DIR="${METAX_PKG_DIR:-${METAX_OFFLINE_DIR}}"
METAX_PKG_TGZ="${METAX_PKG_TGZ:-metax-gpu-k8s-package.${METAX_VERSION}.tar.gz}"  # 资源包文件名
# 修复后的 helm chart 目录(deployments/metax-gpu-operator 下仅保留该修复版 chart, 直接 helm 安装)
METAX_CHART_DIR="${METAX_CHART_DIR:-${REPO_ROOT}/deployments/metax-gpu-operator/metax-operator}"
# 镜像加载方式(默认 tar, 从离线 tar 逐镜像加载推送到集群内置 registry):
#   tar = 从 METAX_OFFLINE_DIR/METAX_IMAGE_DIR 加载离线 tar(需先用 metax-save-images.sh 生成)
#   run = 用 metax-k8s-images.<ver>.run 内嵌镜像直接推送(无需预存 tar, 离线可用)
METAX_IMAGE_MODE="${METAX_IMAGE_MODE:-tar}"
METAX_IMAGE_DIR="${METAX_IMAGE_DIR:-${LOCAL_REPO_DIR}/images}"  # tar 模式: 额外镜像 tar 目录(可配置, 优先用 METAX_OFFLINE_DIR)
METAX_TAR_PATTERN="${METAX_TAR_PATTERN:-metax}"                 # tar 模式: 匹配文件名以区分沐曦镜像
# metax-save-images.sh: 从本地 docker 枚举保存的镜像仓库前缀(正则)。
#   默认 ^harbor.isuanova.com/metax/(内网 Harbor 仓库); 也可选 ^cr\.metax-tech\.com/cloud/(沐曦官方仓库,
#   仅取 cloud 前缀避免 public-* 下的大推理镜像重复)。两者都含同内容镜像, 选其一即可。
METAX_SAVE_PATTERN="${METAX_SAVE_PATTERN:-^harbor\.isuanova\.com/metax/}"
# metax-save-images.sh: 枚举中命中即跳过的镜像(正则; 默认排除 sglang 等大推理镜像)
METAX_SAVE_EXCLUDE="${METAX_SAVE_EXCLUDE:-sglang}"
# 核心组件列表(对应 metax-k8s-images.<ver>.run 内嵌镜像, 与版本配套; METAX_LIST_IMAGES=true 可打印保存命令)
METAX_IMAGE_COMPONENTS="${METAX_IMAGE_COMPONENTS:-gpu-label gpu-device gpu-aware topo-master topo-worker operator-controller container-runtime driver-manager gpu-scheduler mx-exporter}"
# 集群内置 registry 仓库路径(默认 registry.local:5000/metax, 即 REGISTRY_DOMAIN:REGISTRY_PORT/metax)
METAX_REGISTRY="${METAX_REGISTRY:-${REGISTRY_DOMAIN}:${REGISTRY_PORT}/metax}"
METAX_NAMESPACE="${METAX_NAMESPACE:-metax-operator}"            # 部署命名空间
METAX_RELEASE_NAME="${METAX_RELEASE_NAME:-metax-gpu-operator}"  # Helm release 名
METAX_CLUSTER_TYPE="${METAX_CLUSTER_TYPE:-k8s}"                 # 集群类型: k8s|k3s(标准 K8s 用 k8s)
# 驱动部署策略: PreferHost=用节点已装内核驱动(默认, 本集群节点已有 3.9.x; 免 driver-image, 避免卸载宿主驱动失败)
#   PreferCloud=Operator 经 DaemonSet 容器化安装驱动(需 driver-image, 会尝试卸载宿主驱动, 卸载失败会 CrashLoop)
METAX_DRIVER_DEPLOY_POLICY="${METAX_DRIVER_DEPLOY_POLICY:-PreferHost}"
METAX_DRIVER_VERSION="${METAX_DRIVER_VERSION:-3.8.1.6-amd64}"  # 内核驱动版本(driver-image:<ver>; 需与本地镜像/离线 tar 匹配)
METAX_MACA_IMAGE="${METAX_MACA_IMAGE:-maca:3.8.1.2-ubuntu20.04-amd64}"  # MXMACA SDK 镜像(最新 3.8, 需与离线 tar/在线拉取匹配)
LWS_ENABLED="${LWS_ENABLED:-false}"                     # modules/03_addon/05_gpu_lws.sh(LeaderWorkerSet, P1-8, 未实现, 默认关)
HAPROXY_ENABLED="${HAPROXY_ENABLED:-false}"             # modules/01_env/05_lb_haproxy.sh(API 四层负载均衡, 默认关, 需要时 --enable)
KEEPALIVED_ENABLED="${KEEPALIVED_ENABLED:-false}"       # modules/01_env/06_lb_keepalived.sh(API VIP 高可用, 默认关, 需要时 --enable)
KEEPALIVED_VIP="${KEEPALIVED_VIP:-}"                    # Keepalived VIP(留空=取 APISERVER_ADDRESS)

# ---------------- P1 阶段附加组件开关(kubespray 集群部署后安装) ----------------
PROMETHEUS_ENABLED="${PROMETHEUS_ENABLED:-false}"       # modules/03_addon/06_prometheus.sh(P1-2/3 监控: Prometheus+Operator+node-exporter/DCGM/MetaX/RDMA/Ceph)
CEPH_ENABLED="${CEPH_ENABLED:-false}"                   # modules/03_addon/07_ceph.sh(P1-6 Ceph 存储底座)
CEPH_CSI_ENABLED="${CEPH_CSI_ENABLED:-false}"           # modules/03_addon/08_ceph_csi.sh(P1-7 Ceph CSI RBD/RGW/CephFS)
ENVOY_GATEWAY_ENABLED="${ENVOY_GATEWAY_ENABLED:-false}" # modules/03_addon/09_envoy_gateway.sh(P1-9 Envoy AI 网关)

# ---------------- P2 阶段附加组件开关 ----------------
KEYCLOAK_ENABLED="${KEYCLOAK_ENABLED:-false}"           # modules/03_addon/10_keycloak.sh(P2-1 统一认证)
KUEUE_ENABLED="${KUEUE_ENABLED:-false}"                 # modules/03_addon/11_kueue.sh(P2-2 队列治理 DEV-29)
KUBEVIRT_ENABLED="${KUBEVIRT_ENABLED:-false}"           # modules/03_addon/12_kubevirt.sh(P2-3 虚拟机能力 DEV-35)

# ---------------- P3 阶段附加组件开关 ----------------
LUSTRE_CSI_ENABLED="${LUSTRE_CSI_ENABLED:-false}"       # modules/03_addon/13_lustre_csi.sh(P3-1 Lustre CSI DEV-26)

# ---------------- 自研模块开关(CubeStack 平台组件) ----------------
# 03_addon/ 下 01~19 为第三方中间件预留, 20 起为 CubeStack 自研模块
CUBESTACK_APPS_ENABLED="${CUBESTACK_APPS_ENABLED:-false}"  # modules/03_addon/20_cubestack_apps.sh(自研组件占位)

# ---------------- 离线镜像预加载(最小集合) ----------------
# 仅同步"部署 kubespray 最小镜像集合"到节点 containerd,避免全量 rsync 无关镜像
# 格式: 空格分隔的匹配条目; 含 ".tar" 为精确文件名匹配, 否则为文件名包含匹配(匹配 images/ 下 *.tar 文件名)
# 留空 = 全量同步 images/ 目录
# 也可在 inventory/${CLUSTER_NAME}/preload-images.conf 中单独覆盖(standalone 运行 cubestack-offline.sh 时)
PRELOAD_IMAGE_PATTERNS="${PRELOAD_IMAGE_PATTERNS:-calico_cni calico_kube-controllers calico_node etcd kube-apiserver kube-controller-manager kube-proxy kube-scheduler coredns cluster-proportional-autoscaler k8s-dns-node-cache metrics-server pause metallb library_registry local-path-provisioner busybox}"
