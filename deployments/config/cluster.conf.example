# ============================================================
# CubeStack 集群统一配置 —— 示例模板(复制为 config/cluster.conf 使用; 真实配置已 gitignore)
#   cp deployments/config/cluster.conf.example deployments/config/cluster.conf
# 本文件 = 必改项 + 暴露方式/VIP + 组件启停开关(*_ENABLED) + 凭据(用户名/密码);
# 其余(版本基线/镜像钉子/组件深度参数/离线路径/NTP/CIDR/…)在 config/cluster.defaults.conf
#   (随仓库分发, load_config 自动加载; 要覆盖任意项: 在本文件写同名变量)
# ★ 核心必改: ① SSH 用户/默认密码 ② NODES 节点清单 ③ METALLB_POOL 地址池
#   (裸金属必须手填 NODES 全部节点 + METALLB_POOL 物理网段空闲段; 虚拟机集群由 create-vms.sh 自动注入)
# ============================================================

# ---- ① 节点 SSH(用户 + 默认密码) ----
# SSH_USER = 全局安装用户(root|ubuntu, 默认 ubuntu): 免密注入/即席 SSH/kubespray ansible_user 都跟随本值;
#   NODES 第4字段写 "-" 跟随本值, 显式写用户名 = 该节点覆盖(与全局不一致时启动告警)。
#   root 要求: 节点须装有 sudo(root 执行 sudo 免密; 缺失时免密步骤会明确报错并给指引)。
#   临时覆盖须把赋值放在 sudo 之后: sudo SSH_USER=root ./deploy-cluster.sh
SSH_USER="${SSH_USER:-ubuntu}"
SSH_DEFAULT_PASSWORD="${SSH_DEFAULT_PASSWORD:-CHANGE_ME}"   # 必改: NODES 密码位为 "-" 时用本值

# ---- ② 集群节点(必改; 5字段: role,hostname,ip,ssh_user,ssh_password) ----
#   role: master|worker;  ssh_user: "-"=跟随全局 SSH_USER;  ssh_password: "-"=用 SSH_DEFAULT_PASSWORD
#   (虚拟机规格在 tools/vm/vm-nodes.conf; create-vms.sh 创建的节点会自动注入本数组)
NODES=(
  "master,cubestack-k8s-master01,10.244.1.11,-,-"
  "worker,cubestack-k8s-worker01,10.244.2.11,-,-"
  "worker,cubestack-k8s-worker02,10.244.2.12,-,-"
)

# ---- ③ MetalLB 地址池(必改) ----
# 池内 IP 与节点同二层且**空闲**; 多集群共用网段时各用不同段(细节见 cluster.defaults.conf §3.1)
METALLB_POOL="10.66.1.131-10.66.1.132"   # ⚠ 必须排除已被其他集群/主机占用的地址(曾用 130-139 把 registry 分到别的集群 VIP 导致镜像拉取失败)

# ════════════════════════════════════════════════════════════
# ★★ 组件启停开关(设 1/true 启用, 0/false 关闭; 各组件的详细参数都在 cluster.defaults.conf) ★★
# ════════════════════════════════════════════════════════════

# ---- 服务暴露方式(全局开关) ----
# metallb(默认) = MetalLB LoadBalancer VIP 暴露(生产; 需 METALLB_POOL 提供同网段空闲 IP);
# nodePort       = NodePort 暴露(不依赖 MetalLB/空闲 VIP; 外部访问 <任一节点IP>:<NodePort>)。
# 其它值一律归一化为 metallb。
# ⚠ registry 默认**独立走 NodePort**(REGISTRY_SERVICE_TYPE=nodeport, 不占 MetalLB VIP);
#   要 registry 也走 LoadBalancer VIP, 显式设 REGISTRY_SERVICE_TYPE=loadbalancer(defaults §3.2)。
SERVICE_EXPOSE_MODE="${SERVICE_EXPOSE_MODE:-metallb}"

# ---- MetalLB + API Server VIP(kube-vip; 见 docs/kube-vip-api-ha.md) ----
METALLB_ENABLED="${METALLB_ENABLED:-true}"              # MetalLB 负载均衡(依赖 3.1 地址池; 需 strict_arp)
# KUBE_VIP_ENABLED: 默认关(不部署 kube-vip, API 入口=首个 master, 单点可用, 零额外机制)。
#   开(true) = 消除 API 入口单点: 置 true 后 --steps kube_vip(或写回上表全量重跑); 存量集群首次切换
#   需走两阶段文档(先让 VIP 就位, 人工确认后再切入口)。关回: 置 false 重跑走清理分支(fail-closed 拦停)。
#   · ⚠ VIP 不在 MetalLB 池内(否则硬失败); 留空 K8S_API_VIP 时会在 .210~.254 探测, 整段被占则硬失败
#   · 静态 Pod 由 kubespray 渲染(sync 写 addons.yml); 09_kube_vip 只负责推导/校验/核验/清理
KUBE_VIP_ENABLED="${KUBE_VIP_ENABLED:-false}"           # 默认关: 不部署 kube-vip, API 入口=首个 master(见下)
K8S_API_VIP="${K8S_API_VIP:-}"                          # 留空=自动推导(各 master 探测 .210 起找空闲地址); 显式值优先
                                                        # ⚠ 同网段跑**多套集群**时必须各用**不同** VIP:两边 kube-vip 会抢同一地址 ⇒
                                                        #   客户端到 VIP 的流量随机落到另一套集群 ⇒ TLS 时好时坏
                                                        #   ("x509: certificate signed by unknown authority", 2026-09-29 实机)。
                                                        #   同理 METALLB_POOL 也必须各用不同段(见 3.1)。
# → 网卡(KUBE_VIP_INTERFACE) / 进程级故障检测(KUBE_VIP_CP_DETECT) → cluster.defaults.conf【API 入口细节】节

# ---- Ceph(存储底座 + 模式; 详细参数与凭据见 cluster.defaults.conf §4.3b) ----
CEPH_ENABLED="${CEPH_ENABLED:-false}"                   # Ceph 存储底座(P1; 见 4.3)
CEPH_CSI_ENABLED="${CEPH_CSI_ENABLED:-false}"           # Ceph CSI RBD/RGW/CephFS(依赖 CEPH_ENABLED; 见 4.3)
CEPH_MODE="${CEPH_MODE:-internal}"          # internal(默认, 集群内) | external(接入外部 Ceph)
# → Ceph 子能力开关(CEPHFS_ENABLED / CEPH_RGW_ENABLED / CEPH_DASHBOARD_ENABLED)与 CEPH_FALLBACK_TO_LOCALPATH
#   见 cluster.defaults.conf §4.3b

# ---- CUBESTACK_OPERATOR(平台 Operator: 凭据 + 开关; 参数见 cluster.defaults.conf §4.6b) ----
#   ⚠ 凭据卫生: 默认值一律留空 —— 真实用户名/密码只填在 cluster.conf(已 gitignore), 不得写进本模板。
CUBESTACK_OPERATOR_HARBOR_USER="${CUBESTACK_OPERATOR_HARBOR_USER:-}"
CUBESTACK_OPERATOR_HARBOR_PASSWORD="${CUBESTACK_OPERATOR_HARBOR_PASSWORD:-}"
CUBESTACK_OPERATOR_ENABLED="${CUBESTACK_OPERATOR_ENABLED:-true}"  # 默认启用; chart 随离线包 + 镜像入内置 registry
CUBESTACK_OPERATOR_CLUSTER_CR_ENABLED="${CUBESTACK_OPERATOR_CLUSTER_CR_ENABLED:-true}"  # 打开会一并下发平台组件镜像(离线需另行备齐)
ONLINE_DEPLOY_CUBESTACK_OPERATOR="${ONLINE_DEPLOY_CUBESTACK_OPERATOR:-false}"  # 平台 Operator 镜像来源: false=离线(tar→内置 registry; 默认) / true=在线(按 chart 定义从 Harbor 直拉)
# (NVIDIA 的 ONLINE_DEPLOY_NVIDIA_GPU_OPERATOR 在下方"附加组件开关"区; 两者均于 2026-10-16 挪入主文件)
# → 滚动 chart/镜像 tag(CHART_VERSION / IMAGE_TAG)与同步模式(CHART_SYNC) → defaults §4.6b

# ---- 发布版本(可选; 详见 docs/release-management.md) ----
# 设为 CUBESTACK_RELEASE="2.0.0" 时使用 <CUBESTACK_RELEASE_ROOT>/2.0.0/offline-files/ 内的
# release.env 与离线件(变量默认值在 cluster.defaults.conf §4.10; 或 deploy-cluster.sh --release 2.0.0)。
# 取件: ./deployments/scripts/tools/offline/fetch-offline-from-minio.sh --release 2.0.0 --dest <本地桶根>

# ---- Harbor(集群外仓库; HARBOR_ENABLED 为预留模块开关, HARBOR_MIRROR_* 为镜像源凭据) ----
HARBOR_ENABLED="${HARBOR_ENABLED:-false}"               # Harbor 外部镜像仓库(预留, 见 defaults §1.7)
HARBOR_MIRROR_USER="${HARBOR_MIRROR_USER:-}"                  # Harbor mirrors 项目(公开只读可留空=匿名)
HARBOR_MIRROR_PASSWORD="${HARBOR_MIRROR_PASSWORD:-}"          # Harbor 密码/token

# ---- kubespray 基座/扩容(阶段二) ----
# 注: k8s 基座/扩容均**无 cluster.conf 开关** ——
#     基座 k8s_deploy 恒随全量部署; 扩容 k8s_scale 仅经命令行触发(--with-scale / --steps k8s_scale)。
#     原 K8S_ENABLED / K8S_SCALE_ENABLED 已于 2026-10-16 移除(旧配置残留该行无副作用)。
NTP_ENABLED="${NTP_ENABLED:-1}"                         # 节点时间同步(0=跳过, 不推荐; 见 defaults §2.2)
# 本地代理(kubespray nginx-proxy 静态 Pod: 每节点 127.0.0.1:6443 → 全部 master; 与"外部入口"正交):
#   摘掉 all.yml 的 loadbalancer_apiserver 块实现节点就近出口; kubelet 侧故障切换 ~1s。
#   细节(实现类型/别名/外部 LB 地址)见 defaults【API 入口细节】节
API_LOCAL_LB_ENABLED="${API_LOCAL_LB_ENABLED:-true}"    # 节点侧本地代理(kubespray nginx-proxy 静态 Pod): 每 worker 127.0.0.1:6443 → 全部 master
LOCAL_PATH_ENABLED="${LOCAL_PATH_ENABLED:-true}"        # local-path-provisioner 默认 StorageClass
METRICS_SERVER_ENABLED="${METRICS_SERVER_ENABLED:-true}"  # metrics-server(HPA 依赖)
HELM_ENABLED="${HELM_ENABLED:-true}"                    # Helm(registry 等组件依赖)
INGRESS_NGINX_ENABLED="${INGRESS_NGINX_ENABLED:-false}" # ingress-nginx(HTTP 入口, 需 MetalLB 或 hostNetwork)
DASHBOARD_ENABLED="${DASHBOARD_ENABLED:-false}"         # Kubernetes dashboard
CERT_MANAGER_ENABLED="${CERT_MANAGER_ENABLED:-false}"   # cert-manager(证书签发, 部分 webhook 组件依赖)
GATEWAY_API_ENABLED="${GATEWAY_API_ENABLED:-false}"     # Gateway API CRDs
LOCAL_VOLUME_PROVISIONER_ENABLED="${LOCAL_VOLUME_PROVISIONER_ENABLED:-false}" # kubespray addon: 本地卷静态供给(2.5.0); 默认关, 需要时置 true
NFD_ENABLED="${NFD_ENABLED:-false}"                     # kubespray addon: node-feature-discovery(0.19.0); 默认关, 需要时置 true
# (基座细节: K8s 版本/镜像钉子/CIDR/containerd/CNI/hosts → defaults ★版本节 / §2.x)

# ---- 集群基础设施开关(阶段三) ----
REGISTRY_ENABLED="${REGISTRY_ENABLED:-1}"               # 集群内置 Registry(默认部署; 0=不部署 addon/节点信任, 见 defaults §3.2)
# (registry 域名/端口/容量等细节 → defaults §3.2)

# ---- 附加组件开关(阶段四; 参数见 defaults §4.x) ----
GPU_OPERATOR_ENABLED="${GPU_OPERATOR_ENABLED:-true}"    # 沐曦 GPU Operator(默认启用; 见 4.1)
NVIDIA_GPU_OPERATOR_ENABLED="${NVIDIA_GPU_OPERATOR_ENABLED:-false}"  # NVIDIA GPU Operator(默认关; --enable nvidia_gpu_operator; 见 4.7b)
ONLINE_DEPLOY_NVIDIA_GPU_OPERATOR="${ONLINE_DEPLOY_NVIDIA_GPU_OPERATOR:-false}"  # NVIDIA 部署模式: false=离线(tar→内置 registry; 默认) / true=在线(chart 直拉; 只可达 Harbor 时配 NVIDIA_GPU_OPERATOR_ONLINE_IMAGE_BASE, 见 4.7b)
KEYCLOAK_ENABLED="${KEYCLOAK_ENABLED:-false}"           # 统一认证(占位; 见 4.4)
KUEUE_ENABLED="${KUEUE_ENABLED:-false}"                 # 队列治理(占位; 见 4.4)
KUBEVIRT_ENABLED="${KUBEVIRT_ENABLED:-false}"           # 虚拟机能力(占位; 见 4.4)
LUSTRE_CSI_ENABLED="${LUSTRE_CSI_ENABLED:-false}"       # Lustre CSI(占位; 见 4.5)
MULTUS_ENABLED="${MULTUS_ENABLED:-true}"                # Multus CNI 容器多网卡(见 4.7)
RDMA_ENABLED="${RDMA_ENABLED:-true}"                    # RDMA 共享设备插件(见 4.8)
DEV_LAB_ENABLED="${DEV_LAB_ENABLED:-true}"              # 开发镜像随部署推入内置 registry(大推送排在末位; --skip dev_lab 跳过; 见 4.9)
MODEL_IMAGES_ENABLED="${MODEL_IMAGES_ENABLED:-true}"    # 模型推理镜像(sglang/vllm-metax ≈85G)随部署推入内置 registry(排在 dev_lab 之后 = 最后; --skip model_images 跳过; 见 offline-files/model-collection/README.md)

# ---- 节点组(可选; 配合 --only <组名> 使用) ----
# 示例(按需取消注释并改值):
# NODE_GROUP_new_node="cubestack-k8s-worker02"
# NODE_GROUP_gpu_nodes="cubestack-k8s-worker03,cubestack-k8s-worker04"

# ════════════════════════════════════════════════════════════
# 其余全部在 **cluster.defaults.conf**(load_config 自动加载; 覆盖时在本文件写同名变量):
#   ★ 版本基线/镜像钉子/PRELOAD | API 入口细节
#   §1 宿主机/SSH/API 域名/Harbor | §2 离线路径+MinIO/NTP/CIDR/CNI/containerd/hosts
#   §3 MetalLB/Registry/镜像源 | §4 沐曦/Ceph/平台 Operator/Multus/NVIDIA/RDMA/netshoot/dev-lab
# 加载优先级: 环境变量 > cluster.conf > cluster.defaults.conf
# ════════════════════════════════════════════════════════════
