# CubeStack release-2.0.1 版本变量(发布树真相; 部署时由 load_config 加载)
# 用法: cluster.conf 设 CUBESTACK_RELEASE="2.0.1"(或 deploy-cluster.sh --release 2.0.1)
# 规则: 本文件只放版本面变量; OFFLINE_FILES_ROOT / *_SAVE_DIR 由 load_config 按发布树派生, 不要写在这里。
RELEASE_VERSION=2.0.1

# kubespray: 决定 OFFLINE_FILES_DIR 的版本子目录; release.env 必须显式给出
KUBESPRAY_VERSION=v2.32.0
KUBESPRAY_PROFILE=v2.32.0

# 自研组件: 2.0.1 沿用 2.0.0 的 tag, 组件发布 v2.0.1 后由 release-tag-bump 更新
# operator 镜像 tag 由 chart appVersion 自带(v2.0.0), installer 不传 image.tag;
# 只有需要偏离 chart 时才设 CUBESTACK_OPERATOR_IMAGE_TAG_OVERRIDE(本发布不设)。
# 以下 IMAGE_TAG 仅用于镜像清单/发布树登记。
CUBESTACK_OPERATOR_IMAGE_TAG=v2.0.1
CUBESTACK_OPERATOR_CHART_VERSION=2.0.1
# release 树自带 chart(offline-files/cubestack-operator/charts/), 部署恒用本地副本
CUBESTACK_OPERATOR_CHART_SYNC=offline
# dev-lab: Harbor 三家 tag 命名不一致, 按镜像分别钉不可变 release tag(不再保留 =latest fallback)
# 2.0.0 起三家 Harbor 均提供带 -v2.0.0 的发布 tag; 发布树 tar 必须与之逐字一致(不再用旧后缀兼容)
DEV_LAB_CPU_TAG=py310-torch2.4-v2.0.0
DEV_LAB_MACA_TAG=3.9.0.12-py310-torch2.4-v2.0.0
DEV_LAB_CUDA_TAG=26.08-v2.0.0
# CLI 镜像(发布脚本用它生成 <版本>/cubestack-installer-cli.tar)
CUBESTACK_CLI_IMAGE=harbor.isuanova.com/suanova/cubestack-installer-cli:v2.0.1

# 上游固定版本(与发布树中 tar 文件名一致; 未变化时与 cluster.defaults.conf 相同)
RDMA_IMAGE_TAG=v1.5.4
MULTUS_IMAGE_TAG=v4.2.2-thick

# 上游组件版本(images.manifest 引用; 发布时冻结)
# 发布树内容必须由本文件决定, 不能随发布机的 cluster.conf/cluster.defaults.conf 漂移;
# 这些值与 kubespray v2.32.0 的版本档案(VERSION.profile)逐项一致。
K8S_VERSION=v1.35.8
ETCD_VERSION=v3.6.14
PAUSE_VERSION=3.10.1
COREDNS_VERSION=v1.12.4
DNS_NODE_CACHE_VERSION=1.25.0
CALICO_VERSION=v3.32.2
METRICS_SERVER_VERSION=v0.9.0
CPA_VERSION=v1.10.3
API_LB_NGINX_IMAGE_TAG=1.30.1-alpine
LOCAL_VOLUME_PROVISIONER_VERSION=2.10.0
NFD_VERSION=0.19.0
KUBE_VIP_VERSION=v1.0.3
METALLB_VERSION=v0.13.9
LOCAL_PATH_VERSION=v0.0.37
REGISTRY_IMAGE_TAG=3.1.2
# ceph / rook / csi(kubespray v2.32.0 树内表值)
CEPH_VERSION=v20.2.2
CEPHCSI_VERSION=v3.18.1
CEPH_CSI_OPERATOR_VERSION=v1.1.0
ROOK_VERSION=v1.21.1
SNAPSHOT_CONTROLLER_VERSION=v8.7.0
CSI_SNAPSHOT_METADATA_VERSION=v1.1.0
CSIADDONS_SIDECAR_VERSION=v0.15.1
CSI_ATTACHER_VERSION=v4.13.0
CSI_NODE_DRIVER_REGISTRAR_VERSION=v2.18.0
CSI_PROVISIONER_VERSION=v6.3.0
CSI_RESIZER_VERSION=v2.2.1
CSI_SNAPSHOTTER_VERSION=v8.6.0
# BUSYBOX_TAG 仍用默认 latest, 仅 registry 存储校验用

# metax-gpu(RELEASE_GROUPS 包含时; 与发布树 tar 文件名一致)
METAX_VERSION=0.15.3
METAX_DRIVER_VERSION=3.8.1.6-amd64
METAX_MACA_IMAGE=maca:3.8.1.2-ubuntu22.04-amd64

# nvidia-gpu-operator(RELEASE_GROUPS 包含时; 与发布树 tar 文件名一致)
NVIDIA_GPU_OPERATOR_VERSION=v26.7.2
NVIDIA_GPU_DRIVER_BRANCH=595
NVIDIA_GPU_DRIVER_PRECOMPILED_KERNELS=5.15.0-186-generic
NVIDIA_GPU_DRIVER_PRECOMPILED_KERNEL=5.15.0-186-generic

# 本发布树包含的组(发布脚本/人工核对用)
#   model-collection 的 sglang / vllm-metax 保持各自上游 tag, 以 image-list.tsv 为准
RELEASE_GROUPS="kubespray ceph multus rdma netshoot cubestack-operator dev-lab model-collection metax-gpu nvidia-gpu-operator"
