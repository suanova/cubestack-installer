# Node
node_modules/
dist/

# 部署引擎工作目录
backend/workspace/

# 系统文件
.DS_Store
nohup.out

# 集群统一配置(含密码,勿提交;模板 cluster.conf.example 需提交)
deployments/config/cluster.conf
deployments/config/cluster.conf.bak
# Docker CLI 镜像独立构建上下文(生成目录, build-cli-context.sh 每次构建前重新生成)
deployments/cli-context/
# 断点状态文件(含进度,勿提交)
deployments/config/.deploy.state
# kubespray 生成的 artifacts(kubeconfig/kubectl,含凭据, root 属主)
deployments/kubespray/inventory/*/artifacts/
# 部署生成的 inventory(含密码)
deployments/kubespray/inventory/cubestack-cluster/hosts.yml
deployments/kubespray/inventory/cubestack-cluster/inventory.ini

# 虚拟机基础镜像/磁盘(大文件,勿提交)
deployments/virtual-machine/

# 离线文件(镜像 tar / 二进制 / .deb / 资源包, 大文件不入库; 路径由 OFFLINE_FILES_DIR 等变量切换)
deployments/offline-files/
deployments/kubespray/kubespray/.git
deployments/kubespray/kubespray/.gitattributes
deployments/kubespray/kubespray/.github
deployments/kubespray/kubespray/.gitignore
deployments/kubespray/kubespray/.gitlab-ci
deployments/kubespray/kubespray/.gitlab-ci.yml
deployments/kubespray/kubespray/.gitmodules

# 部署引擎在宿主机生成的临时拷贝(按 ssh 目标命名)
/deployments/*@*/
cluster.conf.backup
